{% comment %}
  Renders a default fallback menu for the header when no menu is assigned.

  Accepts:
  - highlight_item: {String} Menu item title to highlight (optional)

  Usage:
  {% render 'header-default-menu', highlight_item: 'Sale' %}
{% endcomment %}

{%- assign default_menu_items = 'Features,Women,Men,%Sale,Collections' | split: ',' -%}
{%- assign default_menu_urls = '/pages/features,/collections/women,/collections/men,/collections/sale,/collections' | split: ',' -%}

<nav class="header__inline-menu">
  <ul class="list-menu list-menu--inline" role="list">
    {%- for item in default_menu_items -%}
      {%- liquid
        assign is_highlighted = false
        assign clean_highlight = highlight_item | strip | downcase
        assign clean_item = item | strip | downcase
        if clean_highlight != blank and clean_item == clean_highlight
          assign is_highlighted = true
        endif
        assign item_url = default_menu_urls[forloop.index0]
        assign item_handle = item | handleize
      -%}
      <li>
        <a
          id="HeaderMenu-{{ item_handle }}"
          href="{{ item_url }}"
          class="header__menu-item list-menu__item link link--text focus-inset{% if is_highlighted %} header__menu-item--highlight{% endif %}"
        >
          <span>
            {{- item | escape -}}
          </span>
        </a>
      </li>
    {%- endfor -%}
  </ul>
</nav>
