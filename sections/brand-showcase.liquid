{{ 'section-brand-showcase.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign brs_heading       = section.settings.heading
  assign brs_subtitle      = section.settings.subtitle
  assign brs_col_desktop   = section.settings.columns_desktop
  assign brs_col_tablet    = section.settings.columns_tablet
  assign brs_col_mobile    = section.settings.columns_mobile
  assign brs_gap           = section.settings.gap
  assign brs_pad_top       = section.settings.padding_top
  assign brs_pad_bottom    = section.settings.padding_bottom
  assign brs_card_bg       = section.settings.card_bg_color
  assign brs_card_radius   = section.settings.card_border_radius
  assign brs_hover_anim    = section.settings.enable_hover
  assign brs_logo_height   = section.settings.logo_max_height
  assign brs_heading_color = section.settings.heading_color
  assign brs_subtitle_color = section.settings.subtitle_color

  assign brs_has_blocks = false
  if section.blocks.size > 0
    assign brs_has_blocks = true
  endif
-%}

{%- style -%}
  #brand-showcase-{{ section.id }} {
    --brs-pad-top        : {{ brs_pad_top }}px;
    --brs-pad-bottom     : {{ brs_pad_bottom }}px;
    --brs-col-desktop    : {{ brs_col_desktop }};
    --brs-col-tablet     : {{ brs_col_tablet }};
    --brs-col-mobile     : {{ brs_col_mobile }};
    --brs-gap            : {{ brs_gap }}px;
    --brs-card-bg        : {{ brs_card_bg }};
    --brs-card-radius    : {{ brs_card_radius }}px;
    --brs-logo-max-height: {{ brs_logo_height }}px;
    --brs-heading-color  : {{ brs_heading_color }};
    --brs-subtitle-color : {{ brs_subtitle_color }};
  }
{%- endstyle -%}

<section
  id="brand-showcase-{{ section.id }}"
  class="section-brand-showcase{% unless brs_hover_anim %} section-brand-showcase--no-hover{% endunless %}"
  aria-label="{{ brs_heading | default: 'Brands' | escape }}"
  data-section-type="brand-showcase"
  data-no-animate="true"
>
  <div class="brs-container">

    {%- comment -%} ── Header ── {%- endcomment -%}
    {%- if brs_heading != blank or brs_subtitle != blank -%}
      <header class="brs-header">
        {%- if brs_heading != blank -%}
          <h2 class="brs-heading">{{ brs_heading | escape }}</h2>
        {%- endif -%}
        {%- if brs_subtitle != blank -%}
          <p class="brs-subtitle">{{ brs_subtitle | escape }}</p>
        {%- endif -%}
      </header>
    {%- endif -%}

    {%- comment -%} ── Brand Grid: Live Blocks ── {%- endcomment -%}
    {%- if brs_has_blocks -%}
      <ul class="brs-grid" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign block_logo   = block.settings.brand_logo
            assign block_name   = block.settings.brand_name
            assign block_url    = block.settings.brand_url
            assign block_newtab = block.settings.open_new_tab
            assign has_logo     = false
            if block_logo != blank
              assign has_logo = true
            endif
            assign has_link = false
            if block_url != blank
              assign has_link = true
            endif
          -%}

          <li class="brs-card" {{ block.shopify_attributes }}>
            {%- if has_link -%}
              <a
                href="{{ block_url }}"
                class="brs-card__link"
                {% if block_newtab %}target="_blank" rel="noopener noreferrer"{% endif %}
                aria-label="{{ block_name | default: 'Brand' | escape }}"
              >
            {%- endif -%}

            {%- if has_logo -%}
              <img
                src="{{ block_logo | image_url: width: 400 }}"
                srcset="
                  {{ block_logo | image_url: width: 200 }} 200w,
                  {{ block_logo | image_url: width: 400 }} 400w
                "
                sizes="200px"
                width="200"
                height="40"
                alt="{{ block_name | default: block_logo.alt | default: 'Brand logo' | escape }}"
                class="brs-card__logo"
                loading="lazy"
                decoding="async"
              >
            {%- elsif block_name != blank -%}
              <span class="brs-card__name">{{ block_name | escape }}</span>
            {%- endif -%}

            {%- if has_link -%}
              </a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>

    {%- comment -%} ── Brand Grid: Demo Mode (no blocks added) ── {%- endcomment -%}
    {%- else -%}
      {%- assign demo_brands = "demo-brand-1.svg|180 BH&M,demo-brand-2.svg|Alga Skin,demo-brand-3.svg|Bart®,demo-brand-4.svg|spaceo.,demo-brand-5.svg|Day & Night" | split: "," -%}

      <ul
        class="brs-grid brs-grid--demo"
        role="list"
        aria-label="Demo preview – add brand blocks in the Theme Editor"
      >
        {%- for demo_entry in demo_brands -%}
          {%- assign demo_parts = demo_entry | split: "|" -%}
          {%- assign demo_img   = demo_parts[0] | strip -%}
          {%- assign demo_name  = demo_parts[1] | strip -%}

          <li class="brs-card" aria-hidden="true">
            <img
              src="{{ demo_img | asset_url }}"
              alt="{{ demo_name | escape }}"
              width="200"
              height="40"
              class="brs-card__logo"
              loading="lazy"
              decoding="async"
            >
          </li>
        {%- endfor -%}
      </ul>

      <p class="brs-demo-hint" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false">
          <path fill-rule="evenodd" d="M18 10a8 8 0 1 1-16 0 8 8 0 0 1 16 0Zm-7-4a1 1 0 1 1-2 0 1 1 0 0 1 2 0ZM9 9a.75.75 0 0 0 0 1.5h.253a.25.25 0 0 1 .244.304l-.459 2.066A1.75 1.75 0 0 0 10.747 15H11a.75.75 0 0 0 0-1.5h-.253a.25.25 0 0 1-.244-.304l.459-2.066A1.75 1.75 0 0 0 9.253 9H9Z" clip-rule="evenodd"/>
        </svg>
        This is a demo preview. Add brand blocks in the sidebar to display your own logos.
      </p>
    {%- endif -%}

  </div>
</section>

<script src="{{ 'section-brand-showcase.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Brand Showcase",
  "tag": "section",
  "class": "section section-brand-showcase-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Brands"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Discover top beauty brands, from iconic classics to emerging favorites. Find the perfect match for your skincare and makeup needs."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Logos per row (Desktop)",
      "min": 3,
      "max": 8,
      "step": 1,
      "default": 5
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "label": "Logos per row (Tablet)",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Logos per row (Mobile)",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between cards",
      "min": 8,
      "max": 32,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "header",
      "content": "Card Style"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card background color",
      "default": "#F5F5F5"
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "label": "Card border radius",
      "min": 0,
      "max": 16,
      "step": 1,
      "unit": "px",
      "default": 2
    },
    {
      "type": "checkbox",
      "id": "enable_hover",
      "label": "Enable hover animation",
      "default": true
    },
    {
      "type": "range",
      "id": "logo_max_height",
      "label": "Logo max height",
      "min": 20,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#222222"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle color",
      "default": "#6B7280"
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "settings": [
        {
          "type": "image_picker",
          "id": "brand_logo",
          "label": "Brand logo",
          "info": "Recommended: transparent PNG or SVG. Max height is controlled by section settings."
        },
        {
          "type": "text",
          "id": "brand_name",
          "label": "Brand name",
          "info": "Displayed as text if no logo is uploaded. Used as alt text for accessibility."
        },
        {
          "type": "url",
          "id": "brand_url",
          "label": "Brand link",
          "info": "Link to brand collection, page, or external URL. Leave blank for non-clickable card."
        },
        {
          "type": "checkbox",
          "id": "open_new_tab",
          "label": "Open link in new tab",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand Showcase",
      "settings": {
        "heading": "Brands",
        "subtitle": "Discover top beauty brands, from iconic classics to emerging favorites. Find the perfect match for your skincare and makeup needs.",
        "columns_desktop": 5,
        "columns_tablet": 3,
        "columns_mobile": 2,
        "gap": 16,
        "padding_top": 64,
        "padding_bottom": 64,
        "card_bg_color": "#F5F5F5",
        "card_border_radius": 2,
        "enable_hover": true,
        "logo_max_height": 40,
        "heading_color": "#222222",
        "subtitle_color": "#6B7280"
      },
      "blocks": [
        {
          "type": "brand",
          "settings": {
            "brand_name": "180 BH&M",
            "open_new_tab": false
          }
        },
        {
          "type": "brand",
          "settings": {
            "brand_name": "Alga Skin",
            "open_new_tab": false
          }
        },
        {
          "type": "brand",
          "settings": {
            "brand_name": "Bart®",
            "open_new_tab": false
          }
        },
        {
          "type": "brand",
          "settings": {
            "brand_name": "spaceo.",
            "open_new_tab": false
          }
        },
        {
          "type": "brand",
          "settings": {
            "brand_name": "Day & Night",
            "open_new_tab": false
          }
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
