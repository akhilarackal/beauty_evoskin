{{ 'product-showcase-ingredients.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #psi-{{ section.id }} {
    --psi-bg: {{ section.settings.background_color }};
    --psi-heading-color: {{ section.settings.heading_color }};
    --psi-img-radius: {{ section.settings.image_radius }}px;
    --psi-pad-top: {{ section.settings.padding_top }}px;
    --psi-pad-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<section id="psi-{{ section.id }}" class="psi-section" aria-label="{{ section.settings.heading | default: 'Ingredients Spotlight' | escape }}">
  <div class="psi-container">

    <header class="psi-header">
      {%- if section.settings.heading != blank -%}
        <h2 class="psi-header__title">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </header>

    <div class="psi-layout{% if section.settings.reverse_layout %} psi-layout--reverse{% endif %}">

      {%- comment -%} ── Ingredients List ── {%- endcomment -%}
      <div class="psi-content">
        {%- for block in section.blocks -%}
          {%- if block.type == 'ingredient' -%}
            <div class="psi-ingredient" {{ block.shopify_attributes }}>
              <h3 class="psi-ingredient__name">{{ block.settings.name }}</h3>
              {%- if block.settings.description != blank -%}
                <p class="psi-ingredient__desc">{{ block.settings.description }}</p>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- comment -%} ── Images ── {%- endcomment -%}
      <div class="psi-images">
        {%- if section.settings.image_1 != blank -%}
          <div class="psi-images__item psi-images__item--tall">
            <img
              src="{{ section.settings.image_1 | image_url: width: 600 }}"
              srcset="{{ section.settings.image_1 | image_url: width: 400 }} 400w, {{ section.settings.image_1 | image_url: width: 600 }} 600w"
              sizes="(max-width: 749px) 100vw, 25vw"
              alt="{{ section.settings.image_1_alt | default: 'Ingredient image' | escape }}"
              width="600"
              height="800"
              loading="lazy"
            >
          </div>
        {%- else -%}
          <div class="psi-images__item psi-images__item--tall">
            {{ 'product-2' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {%- endif -%}

        {%- if section.settings.image_2 != blank -%}
          <div class="psi-images__item">
            <img
              src="{{ section.settings.image_2 | image_url: width: 400 }}"
              srcset="{{ section.settings.image_2 | image_url: width: 300 }} 300w, {{ section.settings.image_2 | image_url: width: 400 }} 400w"
              sizes="(max-width: 749px) 50vw, 15vw"
              alt="{{ section.settings.image_2_alt | default: 'Ingredient detail' | escape }}"
              width="400"
              height="400"
              loading="lazy"
            >
          </div>
        {%- else -%}
          <div class="psi-images__item">
            {{ 'product-3' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {%- endif -%}

        {%- if section.settings.image_3 != blank -%}
          <div class="psi-images__item">
            <img
              src="{{ section.settings.image_3 | image_url: width: 400 }}"
              srcset="{{ section.settings.image_3 | image_url: width: 300 }} 300w, {{ section.settings.image_3 | image_url: width: 400 }} 400w"
              sizes="(max-width: 749px) 50vw, 15vw"
              alt="{{ section.settings.image_3_alt | default: 'Ingredient texture' | escape }}"
              width="400"
              height="400"
              loading="lazy"
            >
          </div>
        {%- else -%}
          <div class="psi-images__item">
            {{ 'product-4' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {%- endif -%}
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Ingredients Spotlight",
  "tag": "section",
  "class": "product-showcase-ingredients",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ingredients Spotlight"
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Main image (tall)"
    },
    {
      "type": "text",
      "id": "image_1_alt",
      "label": "Main image alt text"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Top right image"
    },
    {
      "type": "text",
      "id": "image_2_alt",
      "label": "Top right alt text"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Bottom right image"
    },
    {
      "type": "text",
      "id": "image_3_alt",
      "label": "Bottom right alt text"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "reverse_layout",
      "label": "Reverse layout (images left)",
      "default": false
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#111827"
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Ingredient name",
          "default": "Vitamin B Gold"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Promotes cellular renewal and helps maintain a youthful, radiant complexion with advanced antioxidant protection."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ingredients Spotlight",
      "blocks": [
        { "type": "ingredient", "settings": { "name": "Vitamin B Gold", "description": "Promotes cellular renewal and helps maintain a youthful, radiant complexion with advanced antioxidant protection." } },
        { "type": "ingredient", "settings": { "name": "Deep Liquid Emulsique", "description": "A deep-penetrating emulsion that delivers active ingredients to the deepest layers of your skin for lasting hydration." } },
        { "type": "ingredient", "settings": { "name": "Cellular Oil", "description": "Premium cellular oil complex that nourishes and repairs the skin barrier while providing intense moisture retention." } }
      ]
    }
  ]
}
{% endschema %}
