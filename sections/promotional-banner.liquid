{{ 'section-promotional-banner.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign pb_badge_text    = section.settings.badge_text
  assign pb_heading       = section.settings.heading
  assign pb_btn_text      = section.settings.button_text
  assign pb_btn_link      = section.settings.button_link
  assign pb_desktop_img   = section.settings.desktop_image
  assign pb_mobile_img    = section.settings.mobile_image
  assign pb_bg_color      = section.settings.banner_bg_color
  assign pb_bg_image      = section.settings.banner_bg_image
  assign pb_border_radius = section.settings.border_radius
  assign pb_pad_top       = section.settings.padding_top
  assign pb_pad_bottom    = section.settings.padding_bottom
  assign pb_cd_enable     = section.settings.countdown_enable
  assign pb_cd_end_date   = section.settings.countdown_end_date
  assign pb_cd_end_time   = section.settings.countdown_end_time
  assign pb_cd_timezone   = section.settings.countdown_timezone
  assign pb_cd_expired    = section.settings.countdown_expired
  assign pb_cd_message    = section.settings.countdown_expired_message
  assign pb_mq_enable     = section.settings.marquee_enable
  assign pb_mq_text       = section.settings.marquee_text
  assign pb_mq_speed      = section.settings.marquee_speed
  assign pb_mq_direction  = section.settings.marquee_direction
  assign pb_badge_bg      = section.settings.badge_bg_color
  assign pb_badge_color   = section.settings.badge_text_color
  assign pb_heading_color = section.settings.heading_color
  assign pb_btn_bg        = section.settings.button_bg_color
  assign pb_btn_color     = section.settings.button_text_color
  assign pb_timer_bg      = section.settings.timer_bg_color
  assign pb_timer_color   = section.settings.timer_text_color
  assign pb_mq_bg         = section.settings.marquee_bg_color
  assign pb_mq_color      = section.settings.marquee_text_color
  assign pb_mq_dir_val    = 'normal'
  if pb_mq_direction == 'right'
    assign pb_mq_dir_val = 'reverse'
  endif

  assign pb_has_image = false
  if pb_desktop_img != blank or pb_mobile_img != blank
    assign pb_has_image = true
  endif
-%}

{%- style -%}
  #pb-{{ section.id }} {
    --pb-bg-color      : {{ pb_bg_color }};
    --pb-radius        : {{ pb_border_radius }}px;
    --pb-badge-bg      : {{ pb_badge_bg }};
    --pb-badge-color   : {{ pb_badge_color }};
    --pb-heading-color : {{ pb_heading_color }};
    --pb-btn-bg        : {{ pb_btn_bg }};
    --pb-btn-color     : {{ pb_btn_color }};
    --pb-timer-bg      : {{ pb_timer_bg }};
    --pb-timer-color   : {{ pb_timer_color }};
    --pb-mq-bg         : {{ pb_mq_bg }};
    --pb-mq-color      : {{ pb_mq_color }};
    --pb-mq-speed      : {{ pb_mq_speed }}s;
    --pb-mq-direction  : {{ pb_mq_dir_val }};
    --pb-pad-top       : {{ pb_pad_top }}px;
    --pb-pad-bottom    : {{ pb_pad_bottom }}px;
  }
{%- endstyle -%}

<div
  id="pb-{{ section.id }}"
  class="pb-section"
  data-section-type="promotional-banner"
  data-countdown-enable="{{ pb_cd_enable }}"
  data-countdown-end="{{ pb_cd_end_date }}T{{ pb_cd_end_time }}"
  data-countdown-timezone="{{ pb_cd_timezone }}"
  data-countdown-expired="{{ pb_cd_expired }}"
>
  <div class="pb-outer">

    <div
      class="pb-card"
      {%- if pb_bg_image != blank -%}
        style="background-image:url('{{ pb_bg_image | image_url: width: 1600 }}');"
      {%- endif -%}
    >

      <div class="pb-left">
        {%- if pb_badge_text != blank -%}
          <span class="pb-badge">{{ pb_badge_text | escape }}</span>
        {%- endif -%}
        {%- if pb_heading != blank -%}
          <h2 class="pb-heading">{{ pb_heading | escape }}</h2>
        {%- endif -%}
        {%- if pb_btn_text != blank -%}
          <a
            href="{{ pb_btn_link | default: '#' }}"
            class="pb-button"
            {% if pb_btn_link == blank %}aria-disabled="true"{% endif %}
          >{{ pb_btn_text | escape }}</a>
        {%- endif -%}
      </div>

      <div class="pb-center">
        {%- if pb_has_image -%}

          {%- if pb_desktop_img != blank -%}
            <img
              src="{{ pb_desktop_img | image_url: width: 600 }}"
              srcset="{{ pb_desktop_img | image_url: width: 300 }} 300w, {{ pb_desktop_img | image_url: width: 500 }} 500w, {{ pb_desktop_img | image_url: width: 600 }} 600w"
              sizes="(max-width:599px) 0px, (max-width:989px) 220px, 320px"
              width="320"
              height="256"
              alt="{{ pb_desktop_img.alt | default: pb_heading | escape }}"
              class="pb-center__img pb-center__img--desktop"
              loading="eager"
              fetchpriority="high"
            >
          {%- endif -%}

          {%- if pb_mobile_img != blank -%}
            <img
              src="{{ pb_mobile_img | image_url: width: 400 }}"
              srcset="{{ pb_mobile_img | image_url: width: 200 }} 200w, {{ pb_mobile_img | image_url: width: 400 }} 400w"
              sizes="(max-width:599px) 80vw, 0px"
              width="200"
              height="200"
              alt="{{ pb_mobile_img.alt | default: pb_heading | escape }}"
              class="pb-center__img pb-center__img--mobile"
              loading="eager"
            >
          {%- elsif pb_desktop_img != blank -%}
            <img
              src="{{ pb_desktop_img | image_url: width: 400 }}"
              srcset="{{ pb_desktop_img | image_url: width: 200 }} 200w, {{ pb_desktop_img | image_url: width: 400 }} 400w"
              sizes="(max-width:599px) 80vw, 0px"
              width="200"
              height="200"
              alt="{{ pb_desktop_img.alt | default: pb_heading | escape }}"
              class="pb-center__img pb-center__img--mobile"
              loading="eager"
            >
          {%- endif -%}

        {%- else -%}
          <img
            src="{{ 'pb-demo-model.svg' | asset_url }}"
            alt=""
            aria-hidden="true"
            width="382"
            height="252"
            class="pb-center__img pb-center__img--demo"
            loading="eager"
          >
        {%- endif -%}
      </div>

      <div class="pb-right">
        {%- if pb_cd_enable -%}
          <div
            class="pb-countdown"
            id="pb-countdown-{{ section.id }}"
            aria-label="Sale countdown timer"
            data-end="{{ pb_cd_end_date }}T{{ pb_cd_end_time }}"
            data-timezone="{{ pb_cd_timezone }}"
            data-expired="{{ pb_cd_expired }}"
            data-section="{{ section.id }}"
          >
            <div class="pb-timer-unit">
              <div class="pb-timer-box">
                <span class="pb-timer-number" data-unit="days">00</span>
              </div>
              <span class="pb-timer-label">Days</span>
            </div>
            <span class="pb-timer-colon" aria-hidden="true">:</span>
            <div class="pb-timer-unit">
              <div class="pb-timer-box">
                <span class="pb-timer-number" data-unit="hours">00</span>
              </div>
              <span class="pb-timer-label">Hours</span>
            </div>
            <span class="pb-timer-colon" aria-hidden="true">:</span>
            <div class="pb-timer-unit">
              <div class="pb-timer-box">
                <span class="pb-timer-number" data-unit="minutes">00</span>
              </div>
              <span class="pb-timer-label">Minutes</span>
            </div>
            <span class="pb-timer-colon" aria-hidden="true">:</span>
            <div class="pb-timer-unit">
              <div class="pb-timer-box">
                <span class="pb-timer-number" data-unit="seconds">00</span>
              </div>
              <span class="pb-timer-label">Seconds</span>
            </div>
            <span class="visually-hidden" aria-live="polite" id="pb-cd-sr-{{ section.id }}"></span>
          </div>

          {%- if pb_cd_expired == 'message' -%}
            <div class="pb-expired-msg" id="pb-expired-{{ section.id }}" hidden>
              <p>{{ pb_cd_message | default: 'Sale has ended.' | escape }}</p>
            </div>
          {%- endif -%}

        {%- else -%}
          <div class="pb-countdown pb-countdown--static" aria-hidden="true">
            <div class="pb-timer-unit">
              <div class="pb-timer-box"><span class="pb-timer-number">02</span></div>
              <span class="pb-timer-label">Days</span>
            </div>
            <span class="pb-timer-colon">:</span>
            <div class="pb-timer-unit">
              <div class="pb-timer-box"><span class="pb-timer-number">02</span></div>
              <span class="pb-timer-label">Hours</span>
            </div>
            <span class="pb-timer-colon">:</span>
            <div class="pb-timer-unit">
              <div class="pb-timer-box"><span class="pb-timer-number">29</span></div>
              <span class="pb-timer-label">Minutes</span>
            </div>
            <span class="pb-timer-colon">:</span>
            <div class="pb-timer-unit">
              <div class="pb-timer-box"><span class="pb-timer-number">17</span></div>
              <span class="pb-timer-label">Seconds</span>
            </div>
          </div>
        {%- endif -%}
      </div>

    </div>

    {%- if pb_mq_enable -%}
      <div
        class="pb-marquee"
        id="pb-marquee-{{ section.id }}"
        aria-hidden="true"
      >
        <div class="pb-marquee__track">
          {%- for i in (1..3) -%}
            <div class="pb-marquee__content">
              {%- for j in (1..12) -%}
                <span class="pb-marquee__item">{{ pb_mq_text | escape }}</span>
                <span class="pb-marquee__sep" aria-hidden="true">&bull;</span>
              {%- endfor -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    {%- unless pb_has_image -%}
      <p class="pb-demo-hint" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M18 10a8 8 0 1 1-16 0 8 8 0 0 1 16 0Zm-7-4a1 1 0 1 1-2 0 1 1 0 0 1 2 0ZM9 9a.75.75 0 0 0 0 1.5h.253a.25.25 0 0 1 .244.304l-.459 2.066A1.75 1.75 0 0 0 10.747 15H11a.75.75 0 0 0 0-1.5h-.253a.25.25 0 0 1-.244-.304l.459-2.066A1.75 1.75 0 0 0 9.253 9H9Z" clip-rule="evenodd"/>
        </svg>
        Upload a product image in the section settings to replace this preview.
      </p>
    {%- endunless -%}

  </div>
</div>

<script src="{{ 'section-promotional-banner.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Promotional Banner",
  "tag": "section",
  "class": "section section-promotional-banner",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "BLACK FRIDAY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tick-Tock! Sale Ends Soon!"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Product image",
      "info": "Recommended: 640 x 512px, transparent PNG. Upload this to replace the demo preview."
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image (optional)",
      "info": "Falls back to product image if not set."
    },
    {
      "type": "image_picker",
      "id": "banner_bg_image",
      "label": "Background image (optional)",
      "info": "Overrides background colour when set."
    },
    {
      "type": "header",
      "content": "Countdown Timer"
    },
    {
      "type": "checkbox",
      "id": "countdown_enable",
      "label": "Enable countdown",
      "default": true
    },
    {
      "type": "text",
      "id": "countdown_end_date",
      "label": "End date",
      "default": "2030-12-31",
      "info": "Format: YYYY-MM-DD"
    },
    {
      "type": "text",
      "id": "countdown_end_time",
      "label": "End time",
      "default": "23:59:59",
      "info": "Format: HH:MM:SS (24-hour)"
    },
    {
      "type": "select",
      "id": "countdown_timezone",
      "label": "Timezone",
      "options": [
        { "value": "UTC",                 "label": "UTC" },
        { "value": "America/New_York",    "label": "Eastern (US)" },
        { "value": "America/Chicago",     "label": "Central (US)" },
        { "value": "America/Denver",      "label": "Mountain (US)" },
        { "value": "America/Los_Angeles", "label": "Pacific (US)" },
        { "value": "Europe/London",       "label": "London" },
        { "value": "Europe/Paris",        "label": "Paris / Berlin" },
        { "value": "Asia/Kolkata",        "label": "India (IST)" },
        { "value": "Asia/Tokyo",          "label": "Tokyo" },
        { "value": "Australia/Sydney",    "label": "Sydney" }
      ],
      "default": "UTC"
    },
    {
      "type": "select",
      "id": "countdown_expired",
      "label": "When timer expires",
      "options": [
        { "value": "hide",    "label": "Hide entire banner" },
        { "value": "message", "label": "Show expired message" },
        { "value": "restart", "label": "Restart automatically" }
      ],
      "default": "hide"
    },
    {
      "type": "text",
      "id": "countdown_expired_message",
      "label": "Expired message",
      "default": "Sale has ended. Check back soon!"
    },
    {
      "type": "header",
      "content": "Marquee Strip"
    },
    {
      "type": "checkbox",
      "id": "marquee_enable",
      "label": "Enable marquee",
      "default": true
    },
    {
      "type": "text",
      "id": "marquee_text",
      "label": "Marquee text",
      "default": "SALE UP TO 50%"
    },
    {
      "type": "range",
      "id": "marquee_speed",
      "label": "Scroll speed (lower = faster)",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "s",
      "default": 20
    },
    {
      "type": "select",
      "id": "marquee_direction",
      "label": "Scroll direction",
      "options": [
        { "value": "left",  "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "banner_bg_color",
      "label": "Banner background",
      "default": "#6D7FD8"
    },
    {
      "type": "color",
      "id": "badge_bg_color",
      "label": "Badge background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Badge text",
      "default": "#3B82F6"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button background",
      "default": "#D4AF37"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "timer_bg_color",
      "label": "Timer box background",
      "default": "#D4AF37"
    },
    {
      "type": "color",
      "id": "timer_text_color",
      "label": "Timer text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "marquee_bg_color",
      "label": "Marquee background",
      "default": "#D4AF37"
    },
    {
      "type": "color",
      "id": "marquee_text_color",
      "label": "Marquee text",
      "default": "#1F2937"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Banner border radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Promotional Banner",
      "settings": {
        "badge_text": "BLACK FRIDAY",
        "heading": "Tick-Tock! Sale Ends Soon!",
        "button_text": "Shop Now",
        "banner_bg_color": "#6D7FD8",
        "badge_bg_color": "#FFFFFF",
        "badge_text_color": "#3B82F6",
        "heading_color": "#FFFFFF",
        "button_bg_color": "#D4AF37",
        "button_text_color": "#FFFFFF",
        "timer_bg_color": "#D4AF37",
        "timer_text_color": "#FFFFFF",
        "marquee_bg_color": "#D4AF37",
        "marquee_text_color": "#1F2937",
        "countdown_enable": true,
        "countdown_end_date": "2030-12-31",
        "countdown_end_time": "23:59:59",
        "countdown_timezone": "UTC",
        "countdown_expired": "hide",
        "marquee_enable": true,
        "marquee_text": "SALE UP TO 50%",
        "marquee_speed": 20,
        "marquee_direction": "left",
        "border_radius": 16,
        "padding_top": 0,
        "padding_bottom": 0
      }
    }
  ],
  "disabled_on": {
    "groups": ["footer"]
  }
}
{% endschema %}
