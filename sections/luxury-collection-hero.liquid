{%- style -%}
  #LuxuryCollectionHero-{{ section.id }} {
    --lch-bg: {{ section.settings.background_color }};
    --lch-eyebrow-color: {{ section.settings.eyebrow_color }};
    --lch-heading-color: {{ section.settings.heading_color }};
    --lch-description-color: {{ section.settings.description_color }};
    --lch-pad-top: {{ section.settings.padding_top }}px;
    --lch-pad-bottom: {{ section.settings.padding_bottom }}px;
    --lch-container-width: {{ section.settings.container_width }}px;
    --lch-content-width: {{ section.settings.content_max_width }}px;
  }
{%- endstyle -%}

{{ 'section-luxury-collection-hero.css' | asset_url | stylesheet_tag }}

<section
  id="LuxuryCollectionHero-{{ section.id }}"
  class="lch"
  aria-label="{{ section.settings.heading | default: 'Luxury Collection' | escape }}"
>
  <div class="lch__container">
    <div class="lch__content">
      {%- if section.settings.eyebrow != blank -%}
        <span class="lch__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}

      <h2 class="lch__heading">{{ section.settings.heading | default: 'The Signature Collections' }}</h2>

      {%- if section.settings.description != blank -%}
        <p class="lch__description">{{ section.settings.description }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Luxury Collection Hero",
  "tag": "div",
  "class": "section section-luxury-collection-hero",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "CURATED SELECTIONS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Signature Collections"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Discover our meticulously crafted rituals, where Swiss cellular precision meets the pure essence of rare botanicals. An invitation to profound skin transformation."
    },
    {
      "type": "header",
      "content": "Design"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow color",
      "default": "#C5A046"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#1F1B15"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description color",
      "default": "#4D4637"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "container_width",
      "label": "Container width",
      "min": 1000,
      "max": 1500,
      "step": 50,
      "unit": "px",
      "default": 1500
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Content max width",
      "min": 600,
      "max": 1200,
      "step": 10,
      "unit": "px",
      "default": 900
    }
  ],
  "presets": [
    {
      "name": "Luxury Collection Hero",
      "settings": {
        "eyebrow": "CURATED SELECTIONS",
        "heading": "The Signature Collections",
        "description": "Discover our meticulously crafted rituals, where Swiss cellular precision meets the pure essence of rare botanicals. An invitation to profound skin transformation.",
        "background_color": "#FFFFFF",
        "eyebrow_color": "#C5A046",
        "heading_color": "#1F1B15",
        "description_color": "#4D4637",
        "padding_top": 96,
        "padding_bottom": 96,
        "container_width": 1500,
        "content_max_width": 900
      }
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
