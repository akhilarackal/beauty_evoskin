{{ 'section-beauty-hero-banner.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign bhb_label          = section.settings.label
  assign bhb_heading        = section.settings.heading
  assign bhb_description    = section.settings.description
  assign bhb_show_desc      = section.settings.show_description
  assign bhb_btn_text       = section.settings.button_text
  assign bhb_btn_link       = section.settings.button_link
  assign bhb_desktop_img    = section.settings.desktop_image
  assign bhb_mobile_img     = section.settings.mobile_image
  assign bhb_img_position   = section.settings.image_position
  assign bhb_enable_overlay = section.settings.enable_overlay
  assign bhb_overlay_color  = section.settings.overlay_color
  assign bhb_overlay_opacity = section.settings.overlay_opacity
  assign bhb_content_align  = section.settings.content_alignment
  assign bhb_banner_height  = section.settings.banner_height
  assign bhb_border_radius  = section.settings.border_radius
  assign bhb_pad_top        = section.settings.padding_top
  assign bhb_pad_bottom     = section.settings.padding_bottom
  assign bhb_label_color    = section.settings.label_color
  assign bhb_heading_color  = section.settings.heading_color
  assign bhb_desc_color     = section.settings.description_color
  assign bhb_btn_bg         = section.settings.button_bg_color
  assign bhb_btn_color      = section.settings.button_text_color

  assign bhb_has_image = false
  if bhb_desktop_img != blank or bhb_mobile_img != blank
    assign bhb_has_image = true
  endif

  assign bhb_overlay_decimal = bhb_overlay_opacity | divided_by: 100.0
-%}

{%- style -%}
  #bhb-{{ section.id }} {
    --bhb-height        : {{ bhb_banner_height }}px;
    --bhb-radius        : {{ bhb_border_radius }}px;
    --bhb-pad-top       : {{ bhb_pad_top }}px;
    --bhb-pad-bottom    : {{ bhb_pad_bottom }}px;
    --bhb-overlay-color : {{ bhb_overlay_color }};
    --bhb-overlay-opacity: {{ bhb_overlay_decimal }};
    --bhb-label-color   : {{ bhb_label_color }};
    --bhb-heading-color : {{ bhb_heading_color }};
    --bhb-desc-color    : {{ bhb_desc_color }};
    --bhb-btn-bg        : {{ bhb_btn_bg }};
    --bhb-btn-color     : {{ bhb_btn_color }};
    --bhb-img-position  : {{ bhb_img_position }};
  }
{%- endstyle -%}

<section
  id="bhb-{{ section.id }}"
  class="section-beauty-hero-banner"
  aria-label="{{ bhb_heading | default: 'Beauty Hero Banner' | escape }}"
  data-section-type="beauty-hero-banner"
  data-no-animate="true"
>
  <div class="bhb-outer">

    <div class="bhb-banner bhb-banner--align-{{ bhb_content_align | default: 'center' }}">

      {%- comment -%} ── Background Image ── {%- endcomment -%}
      {%- if bhb_has_image -%}
        <picture class="bhb-banner__picture">
          {%- if bhb_mobile_img != blank -%}
            <source
              media="(max-width: 599px)"
              srcset="
                {{ bhb_mobile_img | image_url: width: 400 }} 400w,
                {{ bhb_mobile_img | image_url: width: 600 }} 600w,
                {{ bhb_mobile_img | image_url: width: 800 }} 800w
              "
              sizes="100vw"
            >
          {%- endif -%}
          <img
            src="{{ bhb_desktop_img | image_url: width: 1274 }}"
            srcset="
              {{ bhb_desktop_img | image_url: width: 640 }} 640w,
              {{ bhb_desktop_img | image_url: width: 900 }} 900w,
              {{ bhb_desktop_img | image_url: width: 1274 }} 1274w,
              {{ bhb_desktop_img | image_url: width: 1600 }} 1600w
            "
            sizes="(max-width: 599px) 100vw, (max-width: 989px) 100vw, 1274px"
            width="1274"
            height="{{ bhb_banner_height }}"
            alt="{{ bhb_desktop_img.alt | default: bhb_heading | escape }}"
            class="bhb-banner__img"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          >
        </picture>
      {%- else -%}
        {%- comment -%} Demo mode: bundled local asset {%- endcomment -%}
        <img
          src="{{ 'bhb-demo-banner.svg' | asset_url }}"
          alt=""
          aria-hidden="true"
          width="1274"
          height="200"
          class="bhb-banner__img bhb-banner__img--demo"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        >
      {%- endif -%}

      {%- comment -%} ── Overlay ── {%- endcomment -%}
      {%- if bhb_enable_overlay -%}
        <div class="bhb-banner__overlay" aria-hidden="true"></div>
      {%- endif -%}

      {%- comment -%} ── Content ── {%- endcomment -%}
      <div class="bhb-banner__content">
        {%- if bhb_label != blank -%}
          <span class="bhb-banner__label">{{ bhb_label | escape }}</span>
        {%- endif -%}
        {%- if bhb_heading != blank -%}
          <h2 class="bhb-banner__heading">{{ bhb_heading | escape }}</h2>
        {%- endif -%}
        {%- if bhb_show_desc and bhb_description != blank -%}
          <p class="bhb-banner__description">{{ bhb_description | escape }}</p>
        {%- endif -%}
        {%- if bhb_btn_text != blank -%}
          <a
            href="{{ bhb_btn_link | default: '#' }}"
            class="bhb-banner__btn"
            {% if bhb_btn_link == blank %}aria-disabled="true"{% endif %}
          >{{ bhb_btn_text | escape }}</a>
        {%- endif -%}
      </div>

    </div>

    {%- unless bhb_has_image -%}
      <p class="bhb-demo-hint" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false">
          <path fill-rule="evenodd" d="M18 10a8 8 0 1 1-16 0 8 8 0 0 1 16 0Zm-7-4a1 1 0 1 1-2 0 1 1 0 0 1 2 0ZM9 9a.75.75 0 0 0 0 1.5h.253a.25.25 0 0 1 .244.304l-.459 2.066A1.75 1.75 0 0 0 10.747 15H11a.75.75 0 0 0 0-1.5h-.253a.25.25 0 0 1-.244-.304l.459-2.066A1.75 1.75 0 0 0 9.253 9H9Z" clip-rule="evenodd"/>
        </svg>
        Upload a background image in the section settings to replace this demo preview.
      </p>
    {%- endunless -%}

  </div>
</section>

<script src="{{ 'section-beauty-hero-banner.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Beauty Hero Banner",
  "tag": "section",
  "class": "section section-beauty-hero-banner-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Small label",
      "default": "SEASONAL SALE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "ON YOUR LIGHT"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show description",
      "default": false
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Discover our curated beauty essentials for a radiant glow."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop image",
      "info": "Recommended: 1274 × 200 px. A demo banner shows until uploaded."
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image (optional)",
      "info": "Falls back to desktop image if not set."
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "top",    "label": "Top" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "checkbox",
      "id": "enable_overlay",
      "label": "Enable overlay",
      "default": true
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 25
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content alignment",
      "options": [
        { "value": "left",   "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right",  "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "banner_height",
      "label": "Banner height (desktop)",
      "min": 300,
      "max": 600,
      "step": 10,
      "unit": "px",
      "default": 400
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Label color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button background",
      "default": "#D4AF37"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Beauty Hero Banner",
      "settings": {
        "label": "SEASONAL SALE",
        "heading": "ON YOUR LIGHT",
        "show_description": false,
        "description": "Discover our curated beauty essentials for a radiant glow.",
        "enable_overlay": true,
        "overlay_color": "#000000",
        "overlay_opacity": 25,
        "content_alignment": "center",
        "banner_height": 400,
        "border_radius": 16,
        "padding_top": 40,
        "padding_bottom": 40,
        "label_color": "#FFFFFF",
        "heading_color": "#FFFFFF",
        "description_color": "#FFFFFF",
        "button_bg_color": "#D4AF37",
        "button_text_color": "#FFFFFF",
        "image_position": "center"
      }
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
