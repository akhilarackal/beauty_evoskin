{{ 'section-bestsellers.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign bs_collection  = section.settings.collection
  assign bs_count       = section.settings.products_to_show
  assign bs_heading     = section.settings.heading
  assign bs_show_all    = section.settings.show_shop_all
  assign bs_all_label   = section.settings.shop_all_label
  assign bs_all_url     = section.settings.shop_all_url
  assign bs_col_desktop = section.settings.columns_desktop
  assign bs_col_mobile  = section.settings.columns_mobile
  assign bs_card_radius = section.settings.card_border_radius
  assign bs_card_border = section.settings.card_border_color
  assign bs_card_bg     = section.settings.card_bg_color
  assign bs_img_bg      = section.settings.image_bg_color
  assign bs_hover_anim  = section.settings.enable_hover
  assign bs_pad_top     = section.settings.padding_top
  assign bs_pad_bottom  = section.settings.padding_bottom

  assign bs_href = '/collections/all'
  if bs_collection != blank and bs_collection.url != blank
    assign bs_href = bs_collection.url
  endif
  if bs_all_url != blank
    assign bs_href = bs_all_url
  endif

  assign bs_mode = 'demo'
  if bs_collection != blank
    if bs_collection.products_count > 0
      assign bs_mode = 'live'
    else
      assign bs_mode = 'empty'
    endif
  endif
-%}

{%- style -%}
  .section-bestsellers-{{ section.id }} {
    --bs-pad-top     : {{ bs_pad_top }}px;
    --bs-pad-bottom  : {{ bs_pad_bottom }}px;
    --bs-card-radius : {{ bs_card_radius }}px;
    --bs-card-border : {{ bs_card_border }};
    --bs-card-bg     : {{ bs_card_bg }};
    --bs-img-bg      : {{ bs_img_bg }};
    --bs-col-desktop : {{ bs_col_desktop }};
    --bs-col-mobile  : {{ bs_col_mobile }};
  }
{%- endstyle -%}

<section
  class="section-bestsellers section-bestsellers-{{ section.id }}{% if bs_hover_anim %} bs--hover{% endif %}"
  aria-label="{{ bs_heading | escape }}"
  id="bestsellers-{{ section.id }}"
  data-section-type="bestsellers"
  data-no-animate="true"
>
  <div class="bs-container">

    {%- comment -%} ── Header ── {%- endcomment -%}
    <header class="bs-header">
      {%- if bs_heading != blank -%}
        <h2 class="bs-heading">{{ bs_heading | escape }}</h2>
      {%- endif -%}
      {%- if bs_show_all -%}
        <a
          href="{{ bs_href }}"
          class="bs-shop-all"
          aria-label="{{ bs_all_label | escape }} – {{ bs_heading | escape }}"
        >{{ bs_all_label | escape }}&nbsp;&rsaquo;</a>
      {%- endif -%}
    </header>

    {%- comment -%} ── LIVE mode: collection selected with products ── {%- endcomment -%}
    {%- if bs_mode == 'live' -%}
      <ul class="bs-grid" role="list">
        {%- for product in bs_collection.products limit: bs_count -%}
          {%- liquid
            assign cp          = product.price
            assign cap         = product.compare_at_price
            assign has_compare = false
            if cap > cp
              assign has_compare = true
            endif
            assign is_soldout = false
            unless product.available
              assign is_soldout = true
            endunless
            assign img_loading  = 'lazy'
            assign img_fetchpri = 'auto'
            assign img_decode   = 'async'
            if forloop.index == 1
              assign img_loading  = 'eager'
              assign img_fetchpri = 'high'
              assign img_decode   = 'sync'
            endif
          -%}
          <li
            class="bs-card{% if is_soldout %} bs-card--soldout{% endif %}"
            itemscope
            itemtype="https://schema.org/Product"
          >
            <a
              href="{{ product.url }}"
              class="bs-card__link"
              aria-label="{{ product.title | escape }}{% if is_soldout %} – {{ 'products.product.sold_out' | t }}{% endif %}"
              itemprop="url"
            >
              <div class="bs-card__image-wrap" aria-hidden="true">
                {%- if product.featured_image != blank -%}
                  <img
                    src="{{ product.featured_image | image_url: width: 192 }}"
                    srcset="
                      {{ product.featured_image | image_url: width: 96  }} 96w,
                      {{ product.featured_image | image_url: width: 120 }} 120w,
                      {{ product.featured_image | image_url: width: 192 }} 192w,
                      {{ product.featured_image | image_url: width: 240 }} 240w
                    "
                    sizes="96px"
                    width="96"
                    height="128"
                    alt="{{ product.featured_image.alt | default: product.title | escape }}"
                    class="bs-card__img"
                    loading="{{ img_loading }}"
                    decoding="{{ img_decode }}"
                    fetchpriority="{{ img_fetchpri }}"
                    itemprop="image"
                  >
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'bs-card__img bs-card__img--placeholder' }}
                {%- endif -%}
                {%- if is_soldout -%}
                  <span class="bs-card__badge bs-card__badge--soldout" aria-hidden="true">
                    {{- 'products.product.sold_out' | t -}}
                  </span>
                {%- endif -%}
              </div>

              <div class="bs-card__content">
                {%- if product.vendor != blank -%}
                  <p class="bs-card__vendor" itemprop="brand">{{ product.vendor | escape }}</p>
                {%- endif -%}
                <h3 class="bs-card__title" itemprop="name">{{ product.title | escape }}</h3>
                <div
                  class="bs-card__price-row"
                  itemprop="offers"
                  itemscope
                  itemtype="https://schema.org/Offer"
                >
                  <meta itemprop="priceCurrency" content="{{ cart.currency.iso_code }}">
                  <meta itemprop="availability" content="https://schema.org/{% if is_soldout %}OutOfStock{% else %}InStock{% endif %}">
                  <span
                    class="bs-card__price bs-card__price--current{% if has_compare %} bs-card__price--sale{% endif %}"
                    itemprop="price"
                    content="{{ cp | divided_by: 100.0 }}"
                  >{{- cp | money -}}</span>
                  {%- if has_compare -%}
                    <s
                      class="bs-card__price bs-card__price--compare"
                      aria-label="{{ 'products.product.price.regular_price' | t }}: {{ cap | money }}"
                    >{{- cap | money -}}</s>
                  {%- endif -%}
                </div>
              </div>
            </a>

            {%- comment -%}
              Quick add. Sits outside the <a> because a button cannot be
              nested inside a link. Single-variant products add straight
              to the cart; anything with options links to the product page.
            {%- endcomment -%}
            {%- unless is_soldout -%}
              {%- assign bs_variant = product.selected_or_first_available_variant -%}
              {%- if product.variants.size == 1 -%}
                <button
                  type="button"
                  class="bs-card__add"
                  data-bs-add="{{ bs_variant.id }}"
                  aria-label="Add {{ product.title | escape }} to cart"
                  title="Add to cart"
                >
                  <svg class="bs-card__add-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
                    <path d="M8 3.2v9.6M3.2 8h9.6" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/>
                  </svg>
                  <svg class="bs-card__add-check" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
                    <path d="M3.5 8.5l3 3 6-6.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                  <span class="bs-card__add-spinner" aria-hidden="true"></span>
                </button>
              {%- else -%}
                <a
                  class="bs-card__add"
                  href="{{ product.url }}"
                  aria-label="Choose options for {{ product.title | escape }}"
                  title="Choose options"
                >
                  <svg class="bs-card__add-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
                    <path d="M8 3.2v9.6M3.2 8h9.6" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/>
                  </svg>
                </a>
              {%- endif -%}
            {%- endunless -%}
          </li>
        {%- endfor -%}
      </ul>

    {%- comment -%} ── EMPTY mode: collection selected but has no products ── {%- endcomment -%}
    {%- elsif bs_mode == 'empty' -%}
      <div class="bs-empty-state" role="status" aria-live="polite">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
          <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
        </svg>
        <p>This collection doesn&rsquo;t contain any products yet.</p>
      </div>

    {%- comment -%} ── DEMO mode: no collection selected – show branded preview cards ── {%- endcomment -%}
    {%- else -%}
      {%- assign _d = "bs-demo-1.svg|Ilon|SOS Hydra Repair Intensive Serum|5600|7500,bs-demo-2.svg|Botiga|Anti-Fatigue Eye Rescue Cream|2900|4500,bs-demo-3.svg|Bembard|After Shave Serum|2290|0,bs-demo-4.svg|Evoskin|Foaming Salt Scrub|3490|4990,bs-demo-5.svg|Luminae|Pure Vitamin C Serum|6200|8500,bs-demo-6.svg|Aqua Leaf|Hydrating Face Wash|1990|2990,bs-demo-7.svg|Luminae|Brightening Night Cream|7500|9900,bs-demo-8.svg|Aqua Leaf|Aloe Vera Gel|1490|0,bs-demo-9.svg|Evoskin|Clay Face Mask|4200|5500,bs-demo-10.svg|Ilon|Beard Growth Oil|3800|0,bs-demo-11.svg|Bembard|Sunscreen SPF 50|2990|3990,bs-demo-12.svg|Botiga|Herbal Body Lotion|2200|3200" | split: "," -%}

      <ul
        class="bs-grid bs-grid--demo"
        role="list"
        aria-label="Demo preview – select a collection to display real products"
      >
        {%- for _entry in _d limit: bs_count -%}
          {%- assign _p     = _entry | split: "|" -%}
          {%- assign _img   = _p[0] | strip -%}
          {%- assign _vend  = _p[1] | strip -%}
          {%- assign _title = _p[2] | strip -%}
          {%- assign _price = _p[3] | strip | times: 1 -%}
          {%- assign _cap   = _p[4] | strip | times: 1 -%}
          {%- assign _has_c = false -%}
          {%- if _cap > _price -%}{%- assign _has_c = true -%}{%- endif -%}

          <li class="bs-card bs-card--demo" aria-hidden="true">
            <div class="bs-card__link bs-card__link--demo">
              <div class="bs-card__image-wrap">
                <img
                  src="{{ _img | asset_url }}"
                  alt=""
                  aria-hidden="true"
                  width="80"
                  height="106"
                  class="bs-card__img bs-card__img--demo"
                  loading="lazy"
                  decoding="async"
                >
              </div>
              <div class="bs-card__content">
                <p class="bs-card__vendor">{{ _vend }}</p>
                <h3 class="bs-card__title">{{ _title }}</h3>
                <div class="bs-card__price-row">
                  <span class="bs-card__price bs-card__price--current{% if _has_c %} bs-card__price--sale{% endif %}">
                    {{- _price | money -}}
                  </span>
                  {%- if _has_c -%}
                    <s class="bs-card__price bs-card__price--compare">{{- _cap | money -}}</s>
                  {%- endif -%}
                </div>
              </div>
            </div>
          </li>
        {%- endfor -%}
      </ul>

      <p class="bs-demo-hint" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false">
          <path fill-rule="evenodd" d="M18 10a8 8 0 1 1-16 0 8 8 0 0 1 16 0Zm-7-4a1 1 0 1 1-2 0 1 1 0 0 1 2 0ZM9 9a.75.75 0 0 0 0 1.5h.253a.25.25 0 0 1 .244.304l-.459 2.066A1.75 1.75 0 0 0 10.747 15H11a.75.75 0 0 0 0-1.5h-.253a.25.25 0 0 1-.244-.304l.459-2.066A1.75 1.75 0 0 0 9.253 9H9Z" clip-rule="evenodd" />
        </svg>
        This is a preview using demo products. Select a collection in the sidebar to display your real products.
      </p>
    {%- endif -%}

  </div>
</section>

<script src="{{ 'section-bestsellers.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Bestsellers",
  "tag": "section",
  "class": "section section-bestsellers-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Bestsellers"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Products load automatically — no manual blocks needed. A demo preview shows until you pick a collection."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Number of products",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 12
    },
    {
      "type": "header",
      "content": "Shop All Link"
    },
    {
      "type": "checkbox",
      "id": "show_shop_all",
      "label": "Show Shop All link",
      "default": true
    },
    {
      "type": "text",
      "id": "shop_all_label",
      "label": "Link label",
      "default": "Shop All"
    },
    {
      "type": "url",
      "id": "shop_all_url",
      "label": "Custom link URL",
      "info": "Leave blank to auto-link to the selected collection."
    },
    {
      "type": "header",
      "content": "Grid Layout"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Desktop columns",
      "options": [
        { "value": "2", "label": "2 columns" },
        { "value": "3", "label": "3 columns" },
        { "value": "4", "label": "4 columns" }
      ],
      "default": "3"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Mobile columns",
      "options": [
        { "value": "1", "label": "1 column" },
        { "value": "2", "label": "2 columns" }
      ],
      "default": "1"
    },
    {
      "type": "header",
      "content": "Card Style"
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "label": "Card border radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card border color",
      "default": "#E5E7EB"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "image_bg_color",
      "label": "Image background",
      "default": "#F3F4F6"
    },
    {
      "type": "checkbox",
      "id": "enable_hover",
      "label": "Enable hover animation",
      "default": true
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Bestsellers",
      "settings": {
        "heading": "Bestsellers",
        "products_to_show": 12,
        "show_shop_all": true,
        "shop_all_label": "Shop All",
        "columns_desktop": "3",
        "columns_mobile": "1",
        "card_border_radius": 8,
        "card_border_color": "#E5E7EB",
        "card_bg_color": "#FFFFFF",
        "image_bg_color": "#F3F4F6",
        "enable_hover": true,
        "padding_top": 48,
        "padding_bottom": 48
      }
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
