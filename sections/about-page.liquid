{%- style -%}
  .about-page {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }
  .about-page__title {
    font-family: 'Playfair Display', serif;
    font-weight: 400;
    font-size: 42px;
    line-height: 1.2;
    color: #1F1B15;
    text-align: center;
    margin: 0 0 24px;
  }
  .about-page__tagline {
    font-family: 'Poppins', sans-serif;
    font-weight: 400;
    font-size: 15px;
    line-height: 1.6;
    color: #374151;
    text-align: center;
    max-width: 600px;
    margin: 0 auto 64px;
  }
  .about-block {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
    margin-bottom: 64px;
  }
  .about-block:last-child {
    margin-bottom: 0;
  }
  .about-block--right .about-block__image {
    order: 2;
  }
  .about-block--right .about-block__content {
    order: 1;
  }
  .about-block__image {
    border-radius: 12px;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: #F3F4F6;
  }
  .about-block__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .about-block__content {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .about-block__heading {
    font-family: 'Playfair Display', serif;
    font-weight: 400;
    font-size: 32px;
    line-height: 1.3;
    color: #1F1B15;
    margin: 0;
  }
  .about-block__desc {
    font-family: 'Poppins', sans-serif;
    font-weight: 400;
    font-size: 14px;
    line-height: 1.8;
    color: #6B7280;
    margin: 0;
  }
  @media screen and (max-width: 749px) {
    .about-block {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .about-block--right .about-block__image { order: 0; }
    .about-block--right .about-block__content { order: 0; }
    .about-page__title { font-size: 32px; }
    .about-block__heading { font-size: 26px; }
  }
{%- endstyle -%}

<div class="about-page page-width">
  {%- if section.settings.page_title != blank -%}
    <h1 class="about-page__title">{{ section.settings.page_title }}</h1>
  {%- endif -%}
  {%- if section.settings.tagline != blank -%}
    <p class="about-page__tagline">{{ section.settings.tagline }}</p>
  {%- endif -%}

  {%- for block in section.blocks -%}
    <div class="about-block{% if block.settings.image_position == 'right' %} about-block--right{% endif %}" {{ block.shopify_attributes }}>
      <div class="about-block__image">
        {%- if block.settings.image != blank -%}
          <img
            src="{{ block.settings.image | image_url: width: 800 }}"
            srcset="{{ block.settings.image | image_url: width: 400 }} 400w, {{ block.settings.image | image_url: width: 600 }} 600w, {{ block.settings.image | image_url: width: 800 }} 800w"
            sizes="(max-width: 749px) 100vw, 50vw"
            alt="{{ block.settings.heading | escape }}"
            width="800"
            height="600"
            loading="lazy"
          >
        {%- endif -%}
      </div>
      <div class="about-block__content">
        {%- if block.settings.heading != blank -%}
          <h2 class="about-block__heading">{{ block.settings.heading }}</h2>
        {%- endif -%}
        {%- if block.settings.description != blank -%}
          <p class="about-block__desc">{{ block.settings.description }}</p>
        {%- endif -%}
      </div>
    </div>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "About Page",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "page_title",
      "label": "Page title",
      "default": "About Us"
    },
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Tagline",
      "default": "Creating Value. Strengthening Communities. Inspiring Progress."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "content_block",
      "name": "Content Block",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Our Mission"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "select",
          "id": "image_position",
          "label": "Image position",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "right", "label": "Right" }
          ],
          "default": "left"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About Page"
    }
  ]
}
{% endschema %}
