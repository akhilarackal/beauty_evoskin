      "label": "Floating label text",
      "default": "Cellular Vitality"
    },
    {
      "type": "color",
      "id": "label_text_color",
      "label": "Label text color",
      "default": "#1F1B15"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "collection_title",
      "label": "Collection title",
      "default": "Cellular Gold"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#1F1B15"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "The Essence of Renewal"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle color",
      "default": "#C5A046"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Infused with pure 24k colloidal gold and our proprietary Phyto-Cellular Complex, this collection is designed to dramatically improve skin elasticity and impart an unprecedented, lit-from-within glow. Every drop is a testament to rigorous scientific research and uncompromising luxury."
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description color",
      "default": "#4D4637"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Explore Collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "button_background_color",
      "label": "Button background color",
      "default": "#D4AF37"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#FDFCFB"
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "label": "Button border radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 8
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Icon (SVG or image)",
          "info": "Recommended: 16x16 or 32x32 SVG/PNG"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Swiss Cellular Tech"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Stimulates deep dermal repair."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Feature Showcase",
      "blocks": [
        {
          "type": "feature",
          "settings": {
