        "padding_bottom": 80,
        "column_gap": 64,
        "image_background_color": "#F2EBE1",
        "enable_floating_label": true,
        "floating_label_text": "Cellular Vitality",
        "collection_title": "Cellular Gold",
        "subtitle": "The Essence of Renewal",
        "description": "Infused with pure 24k colloidal gold and our proprietary Phyto-Cellular Complex, this collection is designed to dramatically improve skin elasticity and impart an unprecedented, lit-from-within glow. Every drop is a testament to rigorous scientific research and uncompromising luxury.",
