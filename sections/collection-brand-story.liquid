{{ 'collection-page-redesign.css' | asset_url | stylesheet_tag }}

<section class="col-brand-story page-width">
  <div class="col-brand-story__inner">
    {%- if section.settings.logo != blank -%}
      <div class="col-brand-story__logo">
        <img
          src="{{ section.settings.logo | image_url: width: 80 }}"
          alt="{{ shop.name }}"
          width="80"
          height="80"
          loading="lazy"
        >
      </div>
    {%- else -%}
      <div class="col-brand-story__logo-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"></path></svg>
      </div>
    {%- endif -%}

    <h2 class="col-brand-story__title">{{ section.settings.heading | default: 'The Alchemy of Purity' }}</h2>
    <p class="col-brand-story__text">{{ section.settings.description | default: 'At Evoskin, we believe that beauty starts with the finest ingredients. Our formulations combine cutting-edge science with organic botanicals, creating products that nourish, protect, and reveal your natural radiance.' }}</p>
  </div>
</section>

{% schema %}
{
  "name": "Brand Story",
  "tag": "div",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo / Icon",
      "info": "Optional decorative logo or icon"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Alchemy of Purity"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "At Evoskin, we believe that beauty starts with the finest ingredients. Our formulations combine cutting-edge science with organic botanicals, creating products that nourish, protect, and reveal your natural radiance."
    }
  ]
}
{% endschema %}
