{{ 'section-campaign-showcase.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign cs_pad_top    = section.settings.padding_top
  assign cs_pad_bottom = section.settings.padding_bottom
  assign cs_gap        = 16
  assign b1_category    = section.settings.b1_category
  assign b1_heading     = section.settings.b1_heading
  assign b1_btn_text    = section.settings.b1_btn_text
  assign b1_btn_link    = section.settings.b1_btn_link
  assign b1_bg_color    = section.settings.b1_bg_color
  assign b1_desktop_img = section.settings.b1_desktop_image
  assign b1_mobile_img  = section.settings.b1_mobile_image
  assign b1_disc_pct    = section.settings.b1_discount_percent
  assign b1_circle_clr  = section.settings.b1_circle_color
  assign b2_category    = section.settings.b2_category
  assign b2_heading     = section.settings.b2_heading
  assign b2_btn_text    = section.settings.b2_btn_text
  assign b2_btn_link    = section.settings.b2_btn_link
  assign b2_bg_color    = section.settings.b2_bg_color
  assign b2_desktop_img = section.settings.b2_desktop_image
  assign b2_mobile_img  = section.settings.b2_mobile_image
  assign b3_badge       = section.settings.b3_badge
  assign b3_heading     = section.settings.b3_heading
  assign b3_desc        = section.settings.b3_description
  assign b3_promo_text  = section.settings.b3_promo_text
  assign b3_promo_code  = section.settings.b3_promo_code
  assign b3_copy_label  = section.settings.b3_copy_label
  assign b3_btn_text    = section.settings.b3_btn_text
  assign b3_btn_link    = section.settings.b3_btn_link
  assign b3_desktop_img = section.settings.b3_desktop_image
  assign b3_mobile_img  = section.settings.b3_mobile_image
  assign b4_category    = section.settings.b4_category
  assign b4_heading     = section.settings.b4_heading
  assign b4_btn_text    = section.settings.b4_btn_text
  assign b4_btn_link    = section.settings.b4_btn_link
  assign b4_bg_color    = section.settings.b4_bg_color
  assign b4_desktop_img = section.settings.b4_desktop_image
  assign b4_mobile_img  = section.settings.b4_mobile_image
  assign b5_category    = section.settings.b5_category
  assign b5_heading     = section.settings.b5_heading
  assign b5_btn_text    = section.settings.b5_btn_text
  assign b5_btn_link    = section.settings.b5_btn_link
  assign b5_bg_color    = section.settings.b5_bg_color
  assign b5_desktop_img = section.settings.b5_desktop_image
  assign b5_mobile_img  = section.settings.b5_mobile_image
-%}

{%- style -%}
  #campaign-showcase-{{ section.id }} {
    --cs-pad-top    : {{ cs_pad_top }}px;
    --cs-pad-bottom : {{ cs_pad_bottom }}px;
  }
{%- endstyle -%}

<section
  id="campaign-showcase-{{ section.id }}"
  class="section-campaign-showcase"
  aria-label="{{ section.settings.b3_heading | default: 'Campaign Showcase' | escape }}"
  data-section-type="campaign-showcase"
  data-no-animate="true"
>
  <div class="cs-container">

    {%- comment -%} ── TOP ROW: Banner 1 + Banner 2 ── {%- endcomment -%}
    <div class="cs-row cs-row--two-col">

      {%- comment -%} ── BANNER 1 ── {%- endcomment -%}
      <article
        class="cs-banner cs-banner--small cs-banner--1"
        style="background-color: {{ b1_bg_color }};"
        aria-label="{{ b1_heading | escape }}"
      >
        {%- comment -%} Background image {%- endcomment -%}
        {%- if b1_desktop_img != blank -%}
          <picture class="cs-banner__picture">
            {%- if b1_mobile_img != blank -%}
              <source
                media="(max-width: 599px)"
                srcset="{{ b1_mobile_img | image_url: width: 800 }} 800w, {{ b1_mobile_img | image_url: width: 400 }} 400w"
                sizes="100vw"
              >
            {%- endif -%}
            <img
              src="{{ b1_desktop_img | image_url: width: 640 }}"
              srcset="{{ b1_desktop_img | image_url: width: 320 }} 320w, {{ b1_desktop_img | image_url: width: 640 }} 640w, {{ b1_desktop_img | image_url: width: 900 }} 900w"
              sizes="(max-width: 599px) 100vw, (max-width: 989px) 50vw, 620px"
              width="640"
              height="280"
              alt="{{ b1_desktop_img.alt | default: b1_heading | escape }}"
              class="cs-banner__img"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            >
          </picture>
        {%- else -%}
          <img
            src="{{ 'bs-demo-2.svg' | asset_url }}"
            alt=""
            aria-hidden="true"
            width="320"
            height="280"
            class="cs-banner__img cs-banner__img--demo"
            loading="eager"
            decoding="async"
          >
        {%- endif -%}

        {%- comment -%} Content overlay {%- endcomment -%}
        <div class="cs-banner__content">
          {%- if b1_category != blank -%}
            <span class="cs-banner__category">{{ b1_category | escape }}</span>
          {%- endif -%}
          {%- if b1_heading != blank -%}
            <h2 class="cs-banner__heading cs-banner__heading--small">{{ b1_heading | escape }}</h2>
          {%- endif -%}
          {%- if b1_btn_text != blank -%}
            <a
              href="{{ b1_btn_link | default: '#' }}"
              class="cs-banner__btn"
              {% if b1_btn_link == blank %}aria-disabled="true"{% endif %}
            >{{ b1_btn_text | escape }}</a>
          {%- endif -%}
        </div>

        {%- comment -%} Discount circle — top right {%- endcomment -%}
        {%- if b1_disc_pct != blank and b1_disc_pct != '' and b1_disc_pct != '0' -%}
          <div
            class="cs-banner__circle"
            style="background-color: {{ b1_circle_clr }};"
            aria-label="Up to {{ b1_disc_pct }}% off"
          >
            <span class="cs-banner__circle-top">UP TO</span>
            <span class="cs-banner__circle-pct">-{{ b1_disc_pct }}%</span>
          </div>
        {%- endif -%}
      </article>
      {%- comment -%} ── END BANNER 1 ── {%- endcomment -%}

      {%- comment -%} ── BANNER 2 ── {%- endcomment -%}
      <article
        class="cs-banner cs-banner--small cs-banner--2"
        style="background-color: {{ b2_bg_color }};"
        aria-label="{{ b2_heading | escape }}"
      >
        {%- if b2_desktop_img != blank -%}
          <picture class="cs-banner__picture">
            {%- if b2_mobile_img != blank -%}
              <source
                media="(max-width: 599px)"
                srcset="{{ b2_mobile_img | image_url: width: 800 }} 800w, {{ b2_mobile_img | image_url: width: 400 }} 400w"
                sizes="100vw"
              >
            {%- endif -%}
            <img
              src="{{ b2_desktop_img | image_url: width: 640 }}"
              srcset="{{ b2_desktop_img | image_url: width: 320 }} 320w, {{ b2_desktop_img | image_url: width: 640 }} 640w, {{ b2_desktop_img | image_url: width: 900 }} 900w"
              sizes="(max-width: 599px) 100vw, (max-width: 989px) 50vw, 620px"
              width="640"
              height="280"
              alt="{{ b2_desktop_img.alt | default: b2_heading | escape }}"
              class="cs-banner__img"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            >
          </picture>
        {%- else -%}
          <img
            src="{{ 'bs-demo-5.svg' | asset_url }}"
            alt=""
            aria-hidden="true"
            width="320"
            height="280"
            class="cs-banner__img cs-banner__img--demo"
            loading="eager"
            decoding="async"
          >
        {%- endif -%}

        <div class="cs-banner__content">
          {%- if b2_category != blank -%}
            <span class="cs-banner__category">{{ b2_category | escape }}</span>
          {%- endif -%}
          {%- if b2_heading != blank -%}
            <h2 class="cs-banner__heading cs-banner__heading--small">{{ b2_heading | escape }}</h2>
          {%- endif -%}
          {%- if b2_btn_text != blank -%}
            <a
              href="{{ b2_btn_link | default: '#' }}"
              class="cs-banner__btn"
              {% if b2_btn_link == blank %}aria-disabled="true"{% endif %}
            >{{ b2_btn_text | escape }}</a>
          {%- endif -%}
        </div>
      </article>
      {%- comment -%} ── END BANNER 2 ── {%- endcomment -%}

    </div>
    {%- comment -%} ── END TOP ROW ── {%- endcomment -%}

    {%- comment -%} ── CENTER ROW: Large Banner 3 ── {%- endcomment -%}
    <article
      class="cs-banner cs-banner--large cs-banner--3"
      aria-label="{{ b3_heading | escape }}"
    >
      {%- comment -%} Background image {%- endcomment -%}
      {%- if b3_desktop_img != blank -%}
        <picture class="cs-banner__picture">
          {%- if b3_mobile_img != blank -%}
            <source
              media="(max-width: 599px)"
              srcset="{{ b3_mobile_img | image_url: width: 800 }} 800w, {{ b3_mobile_img | image_url: width: 400 }} 400w"
              sizes="100vw"
            >
          {%- endif -%}
          <img
            src="{{ b3_desktop_img | image_url: width: 1274 }}"
            srcset="{{ b3_desktop_img | image_url: width: 640 }} 640w, {{ b3_desktop_img | image_url: width: 900 }} 900w, {{ b3_desktop_img | image_url: width: 1274 }} 1274w"
            sizes="(max-width: 599px) 100vw, (max-width: 989px) 100vw, 1274px"
            width="1274"
            height="500"
            alt="{{ b3_desktop_img.alt | default: b3_heading | escape }}"
            class="cs-banner__img"
            loading="lazy"
            decoding="async"
          >
        </picture>
      {%- else -%}
        <img
          src="{{ 'bs-demo-1.svg' | asset_url }}"
          alt=""
          aria-hidden="true"
          width="1274"
          height="500"
          class="cs-banner__img cs-banner__img--demo cs-banner__img--center-demo"
          loading="lazy"
          decoding="async"
        >
      {%- endif -%}

      {%- comment -%} Content overlay — left side {%- endcomment -%}
      <div class="cs-banner__content cs-banner__content--large">
        {%- if b3_badge != blank -%}
          <span class="cs-banner__category">{{ b3_badge | escape }}</span>
        {%- endif -%}
        {%- if b3_heading != blank -%}
          <h2 class="cs-banner__heading cs-banner__heading--large">{{ b3_heading | escape }}</h2>
        {%- endif -%}
        {%- if b3_desc != blank -%}
          <p class="cs-banner__desc">{{ b3_desc | escape }}</p>
        {%- endif -%}
        {%- if b3_promo_text != blank -%}
          <p class="cs-banner__promo-text">{{ b3_promo_text | escape }}</p>
        {%- endif -%}
        {%- if b3_promo_code != blank -%}
          <div class="cs-banner__promo-row">
            <input
              type="text"
              class="cs-banner__promo-input"
              value="{{ b3_promo_code | escape }}"
              readonly
              aria-label="Promo code: {{ b3_promo_code | escape }}"
            >
            <button
              type="button"
              class="cs-banner__copy-btn"
              data-cs-copy="{{ b3_promo_code | escape }}"
              data-cs-copied-label="{{ b3_copy_label | default: 'Copied!' | escape }}"
              aria-label="Copy promo code {{ b3_promo_code | escape }}"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" width="16" height="16">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
              </svg>
              <span class="cs-banner__copy-label">Copy Code</span>
            </button>
          </div>
        {%- endif -%}
        {%- if b3_btn_text != blank -%}
          <a
            href="{{ b3_btn_link | default: '#' }}"
            class="cs-banner__btn cs-banner__btn--large"
            {% if b3_btn_link == blank %}aria-disabled="true"{% endif %}
          >{{ b3_btn_text | escape }}</a>
        {%- endif -%}
      </div>
      {%- comment -%} ── END center content ── {%- endcomment -%}

    </article>
    {%- comment -%} ── END CENTER ROW ── {%- endcomment -%}

    {%- comment -%} ── BOTTOM ROW: Banner 4 + Banner 5 ── {%- endcomment -%}
    <div class="cs-row cs-row--two-col">

      {%- comment -%} ── BANNER 4 ── {%- endcomment -%}
      <article
        class="cs-banner cs-banner--small cs-banner--4"
        style="background-color: {{ b4_bg_color }};"
        aria-label="{{ b4_heading | escape }}"
      >
        {%- if b4_desktop_img != blank -%}
          <picture class="cs-banner__picture">
            {%- if b4_mobile_img != blank -%}
              <source
                media="(max-width: 599px)"
                srcset="{{ b4_mobile_img | image_url: width: 800 }} 800w, {{ b4_mobile_img | image_url: width: 400 }} 400w"
                sizes="100vw"
              >
            {%- endif -%}
            <img
              src="{{ b4_desktop_img | image_url: width: 640 }}"
              srcset="{{ b4_desktop_img | image_url: width: 320 }} 320w, {{ b4_desktop_img | image_url: width: 640 }} 640w, {{ b4_desktop_img | image_url: width: 900 }} 900w"
              sizes="(max-width: 599px) 100vw, (max-width: 989px) 50vw, 620px"
              width="640"
              height="280"
              alt="{{ b4_desktop_img.alt | default: b4_heading | escape }}"
              class="cs-banner__img"
              loading="lazy"
              decoding="async"
            >
          </picture>
        {%- else -%}
          <img
            src="{{ 'bs-demo-8.svg' | asset_url }}"
            alt=""
            aria-hidden="true"
            width="320"
            height="280"
            class="cs-banner__img cs-banner__img--demo"
            loading="lazy"
            decoding="async"
          >
        {%- endif -%}

        <div class="cs-banner__content">
          {%- if b4_category != blank -%}
            <span class="cs-banner__category">{{ b4_category | escape }}</span>
          {%- endif -%}
          {%- if b4_heading != blank -%}
            <h2 class="cs-banner__heading cs-banner__heading--small">{{ b4_heading | escape }}</h2>
          {%- endif -%}
          {%- if b4_btn_text != blank -%}
            <a
              href="{{ b4_btn_link | default: '#' }}"
              class="cs-banner__btn"
              {% if b4_btn_link == blank %}aria-disabled="true"{% endif %}
            >{{ b4_btn_text | escape }}</a>
          {%- endif -%}
        </div>
      </article>
      {%- comment -%} ── END BANNER 4 ── {%- endcomment -%}

      {%- comment -%} ── BANNER 5 ── {%- endcomment -%}
      <article
        class="cs-banner cs-banner--small cs-banner--5"
        style="background-color: {{ b5_bg_color }};"
        aria-label="{{ b5_heading | escape }}"
      >
        {%- if b5_desktop_img != blank -%}
          <picture class="cs-banner__picture">
            {%- if b5_mobile_img != blank -%}
              <source
                media="(max-width: 599px)"
                srcset="{{ b5_mobile_img | image_url: width: 800 }} 800w, {{ b5_mobile_img | image_url: width: 400 }} 400w"
                sizes="100vw"
              >
            {%- endif -%}
            <img
              src="{{ b5_desktop_img | image_url: width: 640 }}"
              srcset="{{ b5_desktop_img | image_url: width: 320 }} 320w, {{ b5_desktop_img | image_url: width: 640 }} 640w, {{ b5_desktop_img | image_url: width: 900 }} 900w"
              sizes="(max-width: 599px) 100vw, (max-width: 989px) 50vw, 620px"
              width="640"
              height="280"
              alt="{{ b5_desktop_img.alt | default: b5_heading | escape }}"
              class="cs-banner__img"
              loading="lazy"
              decoding="async"
            >
          </picture>
        {%- else -%}
          <img
            src="{{ 'bs-demo-9.svg' | asset_url }}"
            alt=""
            aria-hidden="true"
            width="320"
            height="280"
            class="cs-banner__img cs-banner__img--demo"
            loading="lazy"
            decoding="async"
          >
        {%- endif -%}

        <div class="cs-banner__content">
          {%- if b5_category != blank -%}
            <span class="cs-banner__category">{{ b5_category | escape }}</span>
          {%- endif -%}
          {%- if b5_heading != blank -%}
            <h2 class="cs-banner__heading cs-banner__heading--small">{{ b5_heading | escape }}</h2>
          {%- endif -%}
          {%- if b5_btn_text != blank -%}
            <a
              href="{{ b5_btn_link | default: '#' }}"
              class="cs-banner__btn"
              {% if b5_btn_link == blank %}aria-disabled="true"{% endif %}
            >{{ b5_btn_text | escape }}</a>
          {%- endif -%}
        </div>
      </article>
      {%- comment -%} ── END BANNER 5 ── {%- endcomment -%}

    </div>
    {%- comment -%} ── END BOTTOM ROW ── {%- endcomment -%}

  </div>
  {%- comment -%} ── END cs-container ── {%- endcomment -%}

</section>

<script src="{{ 'section-campaign-showcase.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Campaign Showcase",
  "tag": "section",
  "class": "section section-campaign-showcase-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Banner 1 — Face Care"
    },
    {
      "type": "text",
      "id": "b1_category",
      "label": "Category badge",
      "default": "FACE CARE"
    },
    {
      "type": "text",
      "id": "b1_heading",
      "label": "Heading",
      "default": "Glow for Less – Special Offers on Facial Care!"
    },
    {
      "type": "text",
      "id": "b1_btn_text",
      "label": "Button text",
