{{ 'section-flash-deals.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign fd_heading        = section.settings.heading
  assign fd_subtitle       = section.settings.subtitle
  assign fd_collection     = section.settings.collection
  assign fd_count          = section.settings.products_to_show
  assign fd_enable_slider  = section.settings.enable_slider
  assign fd_autoplay       = section.settings.enable_autoplay
  assign fd_autoplay_speed = section.settings.autoplay_speed
  assign fd_show_nav       = section.settings.show_navigation
  assign fd_show_inventory = section.settings.show_inventory_label
  assign fd_ajax_cart      = section.settings.enable_ajax_cart
  assign fd_demo_mode      = section.settings.demo_mode
  assign fd_banner_img_d   = section.settings.banner_desktop_image
  assign fd_banner_img_m   = section.settings.banner_mobile_image
  assign fd_banner_tag     = section.settings.banner_tag_text
  assign fd_banner_heading = section.settings.banner_heading
  assign fd_banner_desc    = section.settings.banner_description
  assign fd_banner_btn_txt = section.settings.banner_button_text
  assign fd_banner_btn_url = section.settings.banner_button_link
  assign fd_banner_align   = section.settings.banner_overlay_align
  assign fd_heading_color  = section.settings.heading_color
  assign fd_subtitle_color = section.settings.subtitle_color
  assign fd_price_color    = section.settings.price_color
  assign fd_badge_bg       = section.settings.sale_badge_color
  assign fd_banner_btn_bg  = section.settings.banner_button_bg
  assign fd_banner_btn_clr = section.settings.banner_button_text_color
  assign fd_tag_bg         = section.settings.face_care_badge_bg
  assign fd_pad_top        = section.settings.padding_top
  assign fd_pad_bottom     = section.settings.padding_bottom
  assign fd_card_radius    = section.settings.card_radius
  assign fd_banner_radius  = section.settings.banner_radius
  assign fd_gap            = section.settings.gap

  assign fd_mode = 'demo'
  if fd_collection != blank
    if fd_collection.products_count > 0
      assign fd_mode = 'live'
    else
      assign fd_mode = 'empty'
    endif
  endif

  assign fd_track_class = 'fd-track'
  unless fd_enable_slider
    assign fd_track_class = 'fd-track fd-track--grid'
  endunless
-%}

{%- style -%}
  #flash-deals-{{ section.id }} {
    --fd-pad-top        : {{ fd_pad_top }}px;
    --fd-pad-bottom     : {{ fd_pad_bottom }}px;
    --fd-card-radius    : {{ fd_card_radius }}px;
    --fd-banner-radius  : {{ fd_banner_radius }}px;
    --fd-gap            : {{ fd_gap }}px;
    --fd-heading-color  : {{ fd_heading_color }};
    --fd-subtitle-color : {{ fd_subtitle_color }};
    --fd-price-color    : {{ fd_price_color }};
    --fd-badge-bg       : {{ fd_badge_bg }};
    --fd-banner-btn-bg  : {{ fd_banner_btn_bg }};
    --fd-banner-btn-color: {{ fd_banner_btn_clr }};
    --fd-tag-bg         : {{ fd_tag_bg }};
  }
{%- endstyle -%}

<section
  id="flash-deals-{{ section.id }}"
  class="section-flash-deals"
  aria-label="{{ fd_heading | default: 'Flash Deals' | escape }}"
  data-section-type="flash-deals"
  data-fd-autoplay="{{ fd_autoplay }}"
  data-fd-speed="{{ fd_autoplay_speed | default: 4 }}"
  data-no-animate="true"
>
  <div class="fd-container">

    {%- comment -%} ── Section Header ── {%- endcomment -%}
    <header class="fd-header">
      <div class="fd-header__left">
        {%- if fd_heading != blank -%}
          <h2 class="fd-heading">{{ fd_heading | escape }}</h2>
        {%- endif -%}
        {%- if fd_subtitle != blank -%}
          <p class="fd-subtitle">{{ fd_subtitle | escape }}</p>
        {%- endif -%}
      </div>

      {%- if fd_enable_slider and fd_show_nav -%}
        <nav class="fd-nav" aria-label="Flash Deals navigation">
          <button
            type="button"
            class="fd-nav__btn"
            data-fd-action="prev"
            aria-label="Previous products"
            disabled
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true" focusable="false">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12.5 15l-5-5 5-5"/>
            </svg>
          </button>
          <button
            type="button"
            class="fd-nav__btn"
            data-fd-action="next"
            aria-label="Next products"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true" focusable="false">
              <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 5l5 5-5 5"/>
            </svg>
          </button>
        </nav>
      {%- elsif fd_enable_slider -%}
        <nav class="fd-nav fd-nav--hidden" aria-hidden="true">
          <button type="button" class="fd-nav__btn" disabled aria-hidden="true"></button>
          <button type="button" class="fd-nav__btn" aria-hidden="true"></button>
        </nav>
      {%- endif -%}
    </header>

    {%- comment -%} ── Main 2-column layout ── {%- endcomment -%}
    <div class="fd-layout">

      {%- comment -%} ── LEFT: Product Cards Column ── {%- endcomment -%}
      <div class="fd-products-col">

        {%- if fd_mode == 'live' -%}
          <div class="fd-slider" role="region" aria-label="Flash deals product slider">
            <ul class="{{ fd_track_class }}" role="list" aria-label="{{ fd_heading | escape }}">

              {%- for product in fd_collection.products limit: fd_count -%}
                {%- liquid
                  assign cp          = product.price
                  assign cap         = product.compare_at_price
                  assign has_compare = false
                  if cap > cp
                    assign has_compare = true
                  endif
                  assign discount_pct = 0
                  if has_compare and cap > 0
                    assign discount_raw = cap | minus: cp
                    assign discount_pct = discount_raw | times: 100 | divided_by: cap
                  endif
                  assign variant     = product.selected_or_first_available_variant
                  assign variant_id  = variant.id
                  assign img_loading  = 'lazy'
                  assign img_fetchpri = 'auto'
                  if forloop.index == 1
                    assign img_loading  = 'eager'
                    assign img_fetchpri = 'high'
                  endif
                  assign low_stock = false
                  if fd_show_inventory and variant.inventory_management != blank
                    if variant.inventory_quantity > 0 and variant.inventory_quantity <= 10
                      assign low_stock = true
                    endif
                  endif
                -%}
                <li class="fd-slide" role="listitem">
                  <article class="fd-card" itemscope itemtype="https://schema.org/Product">
                    <a href="{{ product.url }}" class="fd-card__image-wrap" aria-label="{{ product.title | escape }}" itemprop="url" tabindex="0">
                      {%- if product.featured_image != blank -%}
                        <img
                          src="{{ product.featured_image | image_url: width: 400 }}"
                          srcset="
                            {{ product.featured_image | image_url: width: 200 }} 200w,
                            {{ product.featured_image | image_url: width: 300 }} 300w,
                            {{ product.featured_image | image_url: width: 400 }} 400w,
                            {{ product.featured_image | image_url: width: 600 }} 600w
                          "
                          sizes="(max-width: 599px) calc(50vw - 22px), (max-width: 989px) calc(50vw - 40px), calc(25vw - 24px)"
                          width="400"
                          height="400"
                          alt="{{ product.featured_image.alt | default: product.title | escape }}"
                          class="fd-card__img"
                          loading="{{ img_loading }}"
                          fetchpriority="{{ img_fetchpri }}"
                          decoding="async"
                          itemprop="image"
                        >
                      {%- else -%}
                        {{ 'product-1' | placeholder_svg_tag: 'fd-card__img' }}
                      {%- endif -%}

                      {%- if has_compare and discount_pct > 0 -%}
                        <span class="fd-card__badge" aria-label="{{ discount_pct | round }}% off">-{{ discount_pct | round }}%</span>
                      {%- endif -%}

                      {%- if fd_ajax_cart and variant_id != blank -%}
                        <button
                          type="button"
                          class="fd-card__add-btn"
                          data-variant-id="{{ variant_id }}"
                          aria-label="Add {{ product.title | escape }} to cart"
                          title="Add to cart"
                        >
                          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                            <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                          </svg>
                          <span class="fd-spinner" aria-hidden="true"></span>
                        </button>
                      {%- endif -%}
                    </a>

                    <div class="fd-card__body">
                      <div class="fd-card__price-row" itemprop="offers" itemscope itemtype="https://schema.org/Offer">
                        <meta itemprop="priceCurrency" content="{{ cart.currency.iso_code }}">
                        <meta itemprop="price" content="{{ cp | divided_by: 100.0 }}">
                        <span class="fd-card__price fd-card__price--current">{{ cp | money }}</span>
                        {%- if has_compare -%}
                          <s class="fd-card__price fd-card__price--compare" aria-label="Regular price {{ cap | money }}">{{ cap | money }}</s>
                        {%- endif -%}
                      </div>
                      {%- if product.vendor != blank -%}
                        <p class="fd-card__vendor" itemprop="brand">{{ product.vendor | escape }}</p>
                      {%- endif -%}
                      <h3 class="fd-card__title" itemprop="name">{{ product.title | escape }}</h3>
                      {%- if low_stock -%}
                        <p class="fd-card__inventory">{{ variant.inventory_quantity }} Last Items</p>
                      {%- endif -%}
                    </div>
                  </article>
                </li>
              {%- endfor -%}

            </ul>
          </div>

        {%- elsif fd_mode == 'empty' -%}
          <div class="fd-empty-state" role="status" aria-live="polite">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
              <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"/>
            </svg>
            <p>This collection doesn&rsquo;t have any products yet.</p>
          </div>

        {%- else -%}
          {%- comment -%} DEMO MODE — two realistic skincare cards using bs-demo SVG assets {%- endcomment -%}
          <div class="fd-slider" role="region" aria-label="Flash deals demo preview" aria-hidden="true">
            <ul class="fd-track fd-track--grid" role="list">
              <li class="fd-slide" role="presentation">
                <article class="fd-card fd-card--demo">
                  <div class="fd-card__image-wrap">
                    <img
                      src="{{ 'bs-demo-2.svg' | asset_url }}"
                      alt=""
                      aria-hidden="true"
                      width="400"
                      height="400"
                      class="fd-card__img"
                      loading="lazy"
                      decoding="async"
                    >
                    <span class="fd-card__badge" aria-hidden="true">-36%</span>
                    {%- if fd_ajax_cart -%}
                      <button type="button" class="fd-card__add-btn" aria-hidden="true" tabindex="-1" disabled>
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                        <span class="fd-spinner" aria-hidden="true"></span>
                      </button>
                    {%- endif -%}
                  </div>
                  <div class="fd-card__body">
                    <div class="fd-card__price-row">
                      <span class="fd-card__price fd-card__price--current">₹29.00</span>
                      <s class="fd-card__price fd-card__price--compare">₹45.00</s>
                    </div>
                    <p class="fd-card__vendor">Botiga</p>
                    <h3 class="fd-card__title">Anti-Fatigue Eye Rescue Cream</h3>
                  </div>
                </article>
              </li>
              <li class="fd-slide" role="presentation">
                <article class="fd-card fd-card--demo">
                  <div class="fd-card__image-wrap">
                    <img
                      src="{{ 'bs-demo-3.svg' | asset_url }}"
                      alt=""
                      aria-hidden="true"
                      width="400"
                      height="400"
                      class="fd-card__img"
                      loading="lazy"
                      decoding="async"
                    >
                    {%- if fd_ajax_cart -%}
                      <button type="button" class="fd-card__add-btn" aria-hidden="true" tabindex="-1" disabled>
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                        <span class="fd-spinner" aria-hidden="true"></span>
                      </button>
                    {%- endif -%}
                  </div>
                  <div class="fd-card__body">
                    <div class="fd-card__price-row">
                      <span class="fd-card__price fd-card__price--current">₹22.90</span>
                    </div>
                    <p class="fd-card__vendor">Bernhard</p>
                    <h3 class="fd-card__title">After Shave Serum</h3>
                    <p class="fd-card__inventory" aria-hidden="true">7 Last Items</p>
                  </div>
                </article>
              </li>
            </ul>
          </div>
          <p class="fd-demo-hint" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false">
              <path fill-rule="evenodd" d="M18 10a8 8 0 1 1-16 0 8 8 0 0 1 16 0Zm-7-4a1 1 0 1 1-2 0 1 1 0 0 1 2 0ZM9 9a.75.75 0 0 0 0 1.5h.253a.25.25 0 0 1 .244.304l-.459 2.066A1.75 1.75 0 0 0 10.747 15H11a.75.75 0 0 0 0-1.5h-.253a.25.25 0 0 1-.244-.304l.459-2.066A1.75 1.75 0 0 0 9.253 9H9Z" clip-rule="evenodd"/>
            </svg>
            Demo preview — select a Flash Deals collection in the sidebar to display your real products.
          </p>
        {%- endif -%}

      </div>
      {%- comment -%} END LEFT COLUMN {%- endcomment -%}

      {%- comment -%} ── RIGHT: Promotional Banner Column ── {%- endcomment -%}
      <div class="fd-banner-col">
        <div class="fd-banner fd-banner--align-{{ fd_banner_align | default: 'left' }}" role="complementary" aria-label="{{ fd_banner_heading | escape }}">

          {%- comment -%} Background image (desktop / mobile) {%- endcomment -%}
          {%- if fd_banner_img_d != blank -%}
            <picture>
              {%- if fd_banner_img_m != blank -%}
                <source
                  media="(max-width: 599px)"
                  srcset="{{ fd_banner_img_m | image_url: width: 800 }} 800w, {{ fd_banner_img_m | image_url: width: 400 }} 400w"
                  sizes="100vw"
                >
              {%- endif -%}
              <img
                src="{{ fd_banner_img_d | image_url: width: 900 }}"
                srcset="
                  {{ fd_banner_img_d | image_url: width: 400 }} 400w,
                  {{ fd_banner_img_d | image_url: width: 600 }} 600w,
                  {{ fd_banner_img_d | image_url: width: 900 }} 900w
                "
                sizes="(max-width: 989px) 100vw, 50vw"
                width="900"
                height="453"
                alt="{{ fd_banner_img_d.alt | default: fd_banner_heading | escape }}"
                class="fd-banner__bg"
                loading="lazy"
                decoding="async"
              >
            </picture>
          {%- else -%}
            {%- comment -%} Fallback: use demo model from promotional-banner {%- endcomment -%}
            <img
              src="{{ 'pb-demo-model.svg' | asset_url }}"
              alt=""
              aria-hidden="true"
              width="900"
              height="453"
              class="fd-banner__bg"
              loading="lazy"
              decoding="async"
              style="object-fit: contain; object-position: right center; opacity: 0.7;"
            >
          {%- endif -%}

          {%- comment -%} Overlay content {%- endcomment -%}
          <div class="fd-banner__overlay">
            {%- if fd_banner_tag != blank -%}
              <span class="fd-banner__tag">{{ fd_banner_tag | escape }}</span>
            {%- endif -%}
            {%- if fd_banner_heading != blank -%}
              <h3 class="fd-banner__heading">{{ fd_banner_heading | escape }}</h3>
            {%- endif -%}
            {%- if fd_banner_desc != blank -%}
              <p class="fd-banner__desc">{{ fd_banner_desc | escape }}</p>
            {%- endif -%}
            {%- if fd_banner_btn_txt != blank -%}
              <a
                href="{{ fd_banner_btn_url | default: '#' }}"
                class="fd-banner__btn"
                {% if fd_banner_btn_url == blank %}aria-disabled="true"{% endif %}
              >{{ fd_banner_btn_txt | escape }}</a>
            {%- endif -%}
          </div>

        </div>
      </div>
      {%- comment -%} END RIGHT COLUMN {%- endcomment -%}

    </div>
    {%- comment -%} END fd-layout {%- endcomment -%}

  </div>
  {%- comment -%} END fd-container {%- endcomment -%}

</section>

<script src="{{ 'section-flash-deals.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Flash Deals",
  "tag": "section",
  "class": "section section-flash-deals-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Section Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Flash Deals"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Discover your best deal with unbeatable flash offers."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Flash Deals collection",
      "info": "Products render automatically. A demo preview shows until a collection is selected."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 2,
      "info": "Default 2, maximum 8. Cards show 2-up at a time."
    },
    {
      "type": "header",
      "content": "Banner"
    },
    {
      "type": "image_picker",
      "id": "banner_desktop_image",
      "label": "Background image (desktop)",
      "info": "Recommended: 900 × 453 px"
    },
    {
      "type": "image_picker",
      "id": "banner_mobile_image",
      "label": "Background image (mobile)",
      "info": "Optional. Falls back to desktop image."
    },
    {
      "type": "text",
      "id": "banner_tag_text",
      "label": "Face Care label",
      "default": "FACE CARE"
    },
    {
      "type": "text",
      "id": "banner_heading",
      "label": "Banner heading",
      "default": "Youthful Glow Starts with the Right Facial Care"
    },
    {
      "type": "textarea",
      "id": "banner_description",
      "label": "Banner description",
      "default": "Give your skin the care it deserves and let your natural beauty shine."
    },
    {
      "type": "text",
      "id": "banner_button_text",
      "label": "Button text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "banner_button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "banner_overlay_align",
      "label": "Overlay alignment",
      "options": [
        { "value": "left",   "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right",  "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#222222"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle",
      "default": "#6B7280"
    },
    {
      "type": "color",
      "id": "price_color",
      "label": "Sale price",
      "default": "#EC4899"
    },
    {
      "type": "color",
      "id": "sale_badge_color",
      "label": "Sale badge background",
      "default": "#EC4899"
    },
    {
      "type": "color",
      "id": "banner_button_bg",
      "label": "Banner button background",
      "default": "#2563EB"
    },
    {
      "type": "color",
      "id": "banner_button_text_color",
      "label": "Banner button text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "face_care_badge_bg",
      "label": "Face Care badge background",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card border radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "banner_radius",
      "label": "Banner border radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Column & card gap",
      "min": 8,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Behaviour"
    },
    {
      "type": "checkbox",
      "id": "enable_slider",
      "label": "Enable slider",
      "default": false,
      "info": "When off, all cards show in a 2-column grid. When on, cards slide with Previous/Next."
    },
    {
      "type": "checkbox",
      "id": "enable_autoplay",
      "label": "Enable autoplay",
      "default": false,
      "info": "Only applies when slider is enabled."
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay speed",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_navigation",
      "label": "Show navigation arrows",
      "default": true,
      "info": "Only visible when slider is enabled."
    },
    {
      "type": "checkbox",
      "id": "show_inventory_label",
      "label": "Show low-stock label",
      "default": true,
      "info": "Shows '• X Last Items' when inventory ≤ 10."
    },
    {
      "type": "checkbox",
      "id": "enable_ajax_cart",
      "label": "Enable AJAX add-to-cart",
      "default": true,
      "info": "Shows a + button on each card. Adds to cart without page reload."
    }
  ],
  "presets": [
    {
      "name": "Flash Deals",
      "settings": {
        "heading": "Flash Deals",
