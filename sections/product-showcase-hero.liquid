{{ 'product-showcase-hero.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign current_product = product
  if section.settings.product != blank
    assign current_product = section.settings.product
  endif
  assign show_breadcrumb = section.settings.show_breadcrumb
  assign show_rating = section.settings.show_rating
  assign show_badge = section.settings.show_badge
  assign badge_text = section.settings.badge_text
  assign btn_text = section.settings.button_text
  assign features = section.blocks | where: "type", "feature"
-%}

{%- style -%}
  #psh-{{ section.id }} {
    --psh-bg: {{ section.settings.background_color }};
    --psh-accent: {{ section.settings.accent_color }};
    --psh-heading-color: {{ section.settings.heading_color }};
    --psh-btn-bg: {{ section.settings.button_bg_color }};
    --psh-btn-text: {{ section.settings.button_text_color }};
    --psh-sale-color: {{ section.settings.sale_color }};
    --psh-badge-bg: {{ section.settings.badge_bg_color }};
    --psh-badge-text: {{ section.settings.badge_text_color }};
    --psh-img-bg: {{ section.settings.image_bg_color }};
    --psh-radius: {{ section.settings.image_radius }}px;
    --psh-pad-top: {{ section.settings.padding_top }}px;
    --psh-pad-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<section id="psh-{{ section.id }}" class="psh-section" aria-label="{{ product.title | default: 'Product Showcase' | escape }}">
  <div class="psh-container">
    <div class="psh-grid">

      {%- comment -%} ── Gallery ── {%- endcomment -%}
      <div class="psh-gallery" data-psh-gallery>
        <div class="psh-gallery__main">
          {%- if product != blank and product.featured_image != blank -%}
            <img
              src="{{ product.featured_image | image_url: width: 800 }}"
              srcset="{{ product.featured_image | image_url: width: 400 }} 400w, {{ product.featured_image | image_url: width: 600 }} 600w, {{ product.featured_image | image_url: width: 800 }} 800w"
              sizes="(max-width: 749px) 100vw, 50vw"
              alt="{{ product.featured_image.alt | default: product.title | escape }}"
              width="800"
              height="800"
              loading="eager"
              fetchpriority="high"
              data-psh-main-img
            >
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>

        {%- if product != blank and product.images.size > 1 -%}
          <div class="psh-gallery__thumbs">
            {%- for image in product.images limit: 5 -%}
              <button
                type="button"
                class="psh-gallery__thumb{% if forloop.first %} psh-gallery__thumb--active{% endif %}"
                data-psh-thumb="{{ image | image_url: width: 800 }}"
                aria-label="View image {{ forloop.index }}"
              >
                <img
                  src="{{ image | image_url: width: 100 }}"
                  alt="{{ image.alt | default: product.title | escape }}"
                  width="80"
                  height="80"
                  loading="lazy"
                >
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} ── Product Info ── {%- endcomment -%}
      <div class="psh-info">

        {%- if show_breadcrumb -%}
          <nav class="psh-info__breadcrumb" aria-label="Breadcrumb">
            <a href="/">Home</a>
            <span>/</span>
            {%- if product != blank and product.collections.size > 0 -%}
              <a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a>
              <span>/</span>
            {%- endif -%}
            <span aria-current="page">{{ product.title | default: 'Product Name' }}</span>
          </nav>
        {%- endif -%}

        <h1 class="psh-info__title">{{ product.title | default: 'Cellular Gold Serum' }}</h1>

        {%- if show_rating -%}
          <div class="psh-info__rating">
            <div class="psh-info__stars" aria-hidden="true">
              {%- for i in (1..5) -%}
                <svg viewBox="0 0 20 20" fill="currentColor"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              {%- endfor -%}
            </div>
            <span class="psh-info__rating-text">{{ section.settings.rating_text | default: '4.8 (120 reviews)' }}</span>
          </div>
        {%- endif -%}

        <div class="psh-info__price-wrap">
          {%- if product != blank -%}
            {%- if product.compare_at_price > product.price -%}
              <span class="psh-info__price psh-info__price--compare">{{ product.compare_at_price | money }}</span>
              <span class="psh-info__price psh-info__price--sale">{{ product.price | money }}</span>
            {%- else -%}
              <span class="psh-info__price">{{ product.price | money }}</span>
            {%- endif -%}
          {%- else -%}
            <span class="psh-info__price psh-info__price--compare">$185.00</span>
            <span class="psh-info__price psh-info__price--sale">$87.99</span>
          {%- endif -%}

          {%- if show_badge and badge_text != blank -%}
            <span class="psh-info__badge">{{ badge_text }}</span>
          {%- endif -%}
        </div>

        <div class="psh-info__description">
          {%- if product != blank -%}
            {{ product.description }}
          {%- else -%}
            <p>A luxurious cellular serum formulated with pure 24K gold particles and advanced peptide complexes to restore youthful radiance and firmness.</p>
          {%- endif -%}
        </div>

        {%- if product != blank and product.has_only_default_variant == false -%}
          <div class="psh-variants">
            {%- for option in product.options_with_values -%}
              <div>
                <span class="psh-variants__label">{{ option.name }}:</span>
                <div class="psh-variants__options">
                  {%- for value in option.values -%}
                    <button
                      type="button"
                      class="psh-variants__option{% if forloop.first %} psh-variants__option--active{% endif %}"
                      data-psh-variant="{{ value }}"
                    >{{ value }}</button>
                  {%- endfor -%}
                </div>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <div class="psh-cta">
          {%- if product != blank -%}
            <form method="post" action="/cart/add">
              <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
              <input type="hidden" name="quantity" value="1">
              <button type="submit" class="psh-cta__add-to-cart"{% unless product.available %} disabled{% endunless %}>
                {{ btn_text | default: 'Add to Cart' }}
              </button>
            </form>
          {%- else -%}
            <button type="button" class="psh-cta__add-to-cart">{{ btn_text | default: 'Add to Cart' }}</button>
          {%- endif -%}
          <button type="button" class="psh-cta__buy-now">Buy Now</button>
        </div>

        {%- if features.size > 0 -%}
          <div class="psh-features">
            {%- for block in features -%}
              <div class="psh-features__item" {{ block.shopify_attributes }}>
                <svg class="psh-features__icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd"/>
                </svg>
                <span>{{ block.settings.text }}</span>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}

      </div>
    </div>
  </div>
</section>

<script>
  (function() {
    const section = document.getElementById('psh-{{ section.id }}');
    if (!section) return;
    const mainImg = section.querySelector('[data-psh-main-img]');
    const thumbs = section.querySelectorAll('[data-psh-thumb]');
    thumbs.forEach(thumb => {
      thumb.addEventListener('click', () => {
        if (mainImg) mainImg.src = thumb.dataset.pshThumb;
        thumbs.forEach(t => t.classList.remove('psh-gallery__thumb--active'));
        thumb.classList.add('psh-gallery__thumb--active');
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Product Showcase Hero",
  "tag": "section",
  "class": "product-showcase-hero",
  "settings": [
    {
      "type": "header",
      "content": "Product"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumb",
      "label": "Show breadcrumb",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show rating",
      "default": true
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating text",
      "default": "4.8 (120 reviews)"
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show sale badge",
      "default": true
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "SALE"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Add to cart text",
      "default": "Add to Cart"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#C5A044"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#111827"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button background",
      "default": "#C5A044"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "sale_color",
      "label": "Sale price color",
      "default": "#C5A044"
    },
    {
      "type": "color",
      "id": "badge_bg_color",
      "label": "Badge background",
      "default": "#C5A044"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Badge text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "image_bg_color",
      "label": "Image background",
      "default": "#f5f5f5"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "limit": 5,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Feature text",
          "default": "Free shipping on orders over $50"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Showcase Hero",
      "blocks": [
        { "type": "feature", "settings": { "text": "Free shipping on orders over $50" } },
        { "type": "feature", "settings": { "text": "100% organic ingredients" } },
        { "type": "feature", "settings": { "text": "30-day money back guarantee" } }
      ]
    }
  ]
}
{% endschema %}
