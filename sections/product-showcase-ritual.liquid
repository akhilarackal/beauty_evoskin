{%- liquid
  assign meta_ritual_steps_check = product.metafields.custom.ritual_steps.value
  assign has_ritual_data = false
  if meta_ritual_steps_check != blank and meta_ritual_steps_check.size > 0
    assign has_ritual_data = true
  elsif section.blocks.size > 0
    assign has_ritual_data = true
  endif
-%}

{%- if has_ritual_data -%}
{{ 'product-showcase-ritual.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #psr-{{ section.id }} {
    --psr-bg: {{ section.settings.background_color }};
    --psr-heading-color: {{ section.settings.heading_color }};
    --psr-accent: {{ section.settings.accent_color }};
    --psr-card-radius: {{ section.settings.card_radius }}px;
    --psr-cols: {{ section.settings.columns }};
    --psr-gap: {{ section.settings.gap }}px;
    --psr-pad-top: {{ section.settings.padding_top }}px;
    --psr-pad-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<section id="psr-{{ section.id }}" class="psr-section" aria-label="{{ section.settings.heading | default: 'The Ritual' | escape }}">
  <div class="psr-container">

    <header class="psr-header">
      {%- if section.settings.label != blank -%}
        <span class="psr-header__label">{{ section.settings.label }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="psr-header__title">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subtitle != blank -%}
        <p class="psr-header__subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </header>

    <div class="psr-grid">
      {%- assign meta_ritual_steps = product.metafields.custom.ritual_steps.value -%}
      {%- if meta_ritual_steps != blank and meta_ritual_steps.size > 0 -%}
        {%- for step in meta_ritual_steps -%}
          <div class="psr-card" style="animation-delay: {{ forloop.index0 | times: 120 }}ms;">
            <div class="psr-card__image-wrap">
              {%- if step.image != blank -%}
                <img
                  src="{{ step.image | image_url: width: 500 }}"
                  srcset="{{ step.image | image_url: width: 300 }} 300w, {{ step.image | image_url: width: 500 }} 500w, {{ step.image | image_url: width: 700 }} 700w"
                  sizes="(max-width: 575px) 50vw, (max-width: 989px) 50vw, 25vw"
                  alt="{{ step.title | default: 'Step' | escape }}"
                  width="500"
                  height="625"
                  loading="lazy"
                >
              {%- endif -%}
              <span class="psr-card__step-number">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            </div>
            <div class="psr-card__content">
              {%- if step.title != blank -%}
                <h3 class="psr-card__title">{{ step.title }}</h3>
              {%- endif -%}
              {%- if step.description != blank -%}
                <p class="psr-card__description">{{ step.description }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          <div class="psr-card" {{ block.shopify_attributes }} style="animation-delay: {{ forloop.index0 | times: 120 }}ms;">
            <div class="psr-card__image-wrap">
              {%- if block.settings.image != blank -%}
                <img
                  src="{{ block.settings.image | image_url: width: 500 }}"
                  srcset="{{ block.settings.image | image_url: width: 300 }} 300w, {{ block.settings.image | image_url: width: 500 }} 500w, {{ block.settings.image | image_url: width: 700 }} 700w"
                  sizes="(max-width: 575px) 50vw, (max-width: 989px) 50vw, 25vw"
                  alt="{{ block.settings.title | default: 'Step' | escape }}"
                  width="500"
                  height="625"
                  loading="lazy"
                >
              {%- endif -%}
              <span class="psr-card__step-number">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            </div>
            <div class="psr-card__content">
              {%- if block.settings.title != blank -%}
                <h3 class="psr-card__title">{{ block.settings.title }}</h3>
              {%- endif -%}
              {%- if block.settings.description != blank -%}
                <p class="psr-card__description">{{ block.settings.description }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

  </div>
</section>
{%- endif -%}

<script>
  (function() {
    if (!('IntersectionObserver' in window)) {
      document.querySelectorAll('.psr-card').forEach(function(c) { c.classList.add('psr-card--visible'); });
      return;
    }
    var cards = document.querySelectorAll('#psr-{{ section.id }} .psr-card');
    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('psr-card--visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.15 });
    cards.forEach(function(card) { observer.observe(card); });
  })();
</script>

{% schema %}
{
  "name": "Product Showcase Ritual",
  "tag": "section",
  "class": "product-showcase-ritual",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label (above heading)",
      "default": "APPLICATION"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Ritual"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Follow these simple steps for a perfect skincare routine that reveals your natural glow."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FAF8F5"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#111827"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#C5A044"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 12,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 6,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Cleanse"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Start with a gentle cleanser to prepare your skin."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Showcase Ritual",
      "blocks": [
        { "type": "step", "settings": { "title": "Cleanse", "description": "Start with a gentle cleanser to prepare your skin for the serum." } },
        { "type": "step", "settings": { "title": "Apply Serum", "description": "Apply 2-3 drops of the serum onto your fingertips." } },
        { "type": "step", "settings": { "title": "Massage", "description": "Gently massage into skin using upward circular motions." } },
        { "type": "step", "settings": { "title": "Moisturize", "description": "Seal in the serum with your favorite moisturizer." } }
      ]
    }
  ]
}
{% endschema %}
