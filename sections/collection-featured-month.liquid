{{ 'collection-page-redesign.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign fm_heading = section.settings.heading | default: 'Featured This Month'
  assign fm_collection = section.settings.collection
  assign fm_count = section.settings.products_to_show | default: 6

  if fm_collection == blank
    assign fm_products = collection.products
  else
    assign fm_products = fm_collection.products
  endif
-%}

<section class="col-featured-month page-width">
  <div class="col-featured-month__header">
    <h2 class="col-featured-month__heading">{{ fm_heading }}</h2>
    <div class="col-featured-month__nav">
      <button type="button" class="col-featured-month__nav-btn" data-cfm-prev aria-label="Previous">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"></polyline></svg>
      </button>
      <button type="button" class="col-featured-month__nav-btn" data-cfm-next aria-label="Next">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </button>
    </div>
  </div>

  <div class="col-featured-month__slider" data-cfm-slider>
    <div class="col-featured-month__track">
      {%- for product in fm_products limit: fm_count -%}
        <div class="col-featured-month__card">
          <a href="{{ product.url }}" class="col-featured-month__card-link">
            <div class="col-featured-month__card-image">
              {%- if product.featured_image != blank -%}
                <img
                  src="{{ product.featured_image | image_url: width: 400 }}"
                  alt="{{ product.featured_image.alt | default: product.title | escape }}"
                  loading="lazy"
                  width="400"
                  height="{{ 400 | divided_by: product.featured_image.aspect_ratio | ceil }}"
                >
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag }}
              {%- endif -%}
            </div>
            <div class="col-featured-month__card-info">
              {%- if product.vendor != blank -%}
                <span class="col-featured-month__card-vendor">{{ product.vendor }}</span>
              {%- endif -%}
              <h3 class="col-featured-month__card-title">{{ product.title }}</h3>
              <div class="col-featured-month__card-price">
                <span class="col-featured-month__price-current">{{ product.price | money }}</span>
                {%- if product.compare_at_price > product.price -%}
                  <s class="col-featured-month__price-compare">{{ product.compare_at_price | money }}</s>
                {%- endif -%}
              </div>
            </div>
          </a>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('[data-cfm-slider]').forEach(function(slider) {
      const track = slider.querySelector('.col-featured-month__track');
      const section = slider.closest('.col-featured-month');
      const prevBtn = section.querySelector('[data-cfm-prev]');
      const nextBtn = section.querySelector('[data-cfm-next]');
      const card = track.querySelector('.col-featured-month__card');
      if (!card) return;
      const gap = 20;

      function getScrollAmount() {
        return card.offsetWidth + gap;
      }

      if (prevBtn) {
        prevBtn.addEventListener('click', function() {
          track.scrollBy({ left: -getScrollAmount(), behavior: 'smooth' });
        });
      }
      if (nextBtn) {
        nextBtn.addEventListener('click', function() {
          track.scrollBy({ left: getScrollAmount(), behavior: 'smooth' });
        });
      }
    });
  });
</script>

{% schema %}
{
  "name": "Featured This Month",
  "tag": "div",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured This Month"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Leave blank to use products from the current collection."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 6
    }
  ]
}
{% endschema %}
