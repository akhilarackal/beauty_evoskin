{{ 'section-new-arrivals-carousel.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign nac_heading        = section.settings.heading
  assign nac_show_nav       = section.settings.show_navigation
  assign nac_enable_slider  = section.settings.enable_slider
  assign nac_autoplay       = section.settings.autoplay
  assign nac_autoplay_speed = section.settings.autoplay_speed
  assign nac_card_radius    = section.settings.card_border_radius
  assign nac_img_bg         = section.settings.image_background
  assign nac_show_vendor    = section.settings.show_vendor
  assign nac_show_inventory = section.settings.show_inventory
  assign nac_show_badge     = section.settings.show_sale_badge
  assign nac_show_quick_add = section.settings.quick_add_button
  assign nac_cols_desktop   = section.settings.products_per_desktop
  assign nac_cols_tablet    = section.settings.products_per_tablet
  assign nac_cols_mobile    = section.settings.products_per_mobile
  assign nac_pad_top        = section.settings.padding_top
  assign nac_pad_bottom     = section.settings.padding_bottom
  assign nac_color_heading  = section.settings.color_heading
  assign nac_color_active_tab    = section.settings.color_active_tab
  assign nac_color_active_border = section.settings.color_active_border
  assign nac_color_inactive_tab  = section.settings.color_inactive_tab
  assign nac_color_card_bg  = section.settings.color_card_background
  assign nac_color_badge    = section.settings.color_sale_badge
  assign nac_color_price    = section.settings.color_price
  assign nac_color_compare  = section.settings.color_compare_price
  assign nac_color_vendor   = section.settings.color_vendor
  assign nac_color_title    = section.settings.color_product_title

  assign nac_has_blocks = false
  if section.blocks.size > 0
    assign nac_has_blocks = true
  endif
-%}

{%- style -%}
  #new-arrivals-{{ section.id }} {
    --nac-pad-top         : {{ nac_pad_top }}px;
    --nac-pad-bottom      : {{ nac_pad_bottom }}px;
    --nac-card-radius     : {{ nac_card_radius }}px;
    --nac-img-bg          : {{ nac_img_bg }};
    --nac-cols            : {{ nac_cols_desktop }};
    --nac-cols-tablet     : {{ nac_cols_tablet }};
    --nac-cols-mobile     : {{ nac_cols_mobile }};
    --nac-heading-color   : {{ nac_color_heading }};
    --nac-active-tab      : {{ nac_color_active_tab }};
    --nac-active-border   : {{ nac_color_active_border }};
    --nac-inactive-tab    : {{ nac_color_inactive_tab }};
    --nac-card-bg         : {{ nac_color_card_bg }};
    --nac-badge-bg        : {{ nac_color_badge }};
    --nac-price-color     : {{ nac_color_price }};
    --nac-compare-color   : {{ nac_color_compare }};
    --nac-vendor-color    : {{ nac_color_vendor }};
    --nac-title-color     : {{ nac_color_title }};
  }
{%- endstyle -%}

<section
  id="new-arrivals-{{ section.id }}"
  class="section-new-arrivals-carousel"
  aria-label="{{ nac_heading | default: 'New In' | escape }}"
  data-section-type="new-arrivals-carousel"
  data-nac-autoplay="{{ nac_autoplay }}"
  data-nac-speed="{{ nac_autoplay_speed | default: 4 }}"
  data-nac-cols-desktop="{{ nac_cols_desktop }}"
  data-nac-cols-tablet="{{ nac_cols_tablet }}"
  data-nac-cols-mobile="{{ nac_cols_mobile }}"
  data-no-animate="true"
>
  <div class="nac-container">

    {%- comment -%} ── Section Header ── {%- endcomment -%}
    <header class="nac-header">
      <div class="nac-header__left">
        {%- if nac_heading != blank -%}
          <h2 class="nac-heading">{{ nac_heading | escape }}</h2>
        {%- endif -%}
      </div>

      {%- if nac_show_nav and nac_enable_slider -%}
        <nav class="nac-nav" aria-label="{{ nac_heading | default: 'New In' | escape }} carousel navigation">
          <button type="button" class="nac-nav__btn" data-nac-action="prev" aria-label="Previous products" disabled>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true" focusable="false">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12.5 15l-5-5 5-5"/>
            </svg>
          </button>
          <button type="button" class="nac-nav__btn" data-nac-action="next" aria-label="Next products">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true" focusable="false">
              <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 5l5 5-5 5"/>
            </svg>
          </button>
        </nav>
      {%- endif -%}
    </header>

    {%- comment -%} ── Category Tabs ── {%- endcomment -%}
    {%- if nac_has_blocks -%}
      <div class="nac-tabs" role="tablist" aria-label="Product category tabs">
        {%- for block in section.blocks -%}
          {%- unless block.settings.show_tab -%}{%- continue -%}{%- endunless -%}
          {%- liquid
            assign is_active = false
            if block.settings.default_active
              assign is_active = true
            endif
            if forloop.first and is_active == false
              assign any_default = false
              for b in section.blocks
                if b.settings.default_active and b.settings.show_tab
                  assign any_default = true
                  break
                endif
              endfor
              unless any_default
                assign is_active = true
              endunless
            endif
          -%}
          <button
            type="button"
            class="nac-tab{% if is_active %} nac-tab--active{% endif %}"
            role="tab"
            aria-selected="{{ is_active }}"
            aria-controls="nac-panel-{{ block.id }}"
            id="nac-tab-{{ block.id }}"
            data-nac-tab
            data-block-id="{{ block.id }}"
            {{ block.shopify_attributes }}
          >{{ block.settings.tab_label | default: 'All' | escape }}</button>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- comment -%} ── Tab Panels with Products ── {%- endcomment -%}
    {%- if nac_has_blocks -%}
      {%- for block in section.blocks -%}
        {%- unless block.settings.show_tab -%}{%- continue -%}{%- endunless -%}
        {%- liquid
          assign tab_col = block.settings.collection
          assign is_active = false
          if block.settings.default_active
            assign is_active = true
          endif
          if forloop.first and is_active == false
            assign any_default = false
            for b in section.blocks
              if b.settings.default_active and b.settings.show_tab
                assign any_default = true
                break
              endif
            endfor
            unless any_default
              assign is_active = true
            endunless
          endif
          assign panel_mode = 'demo'
          if tab_col != blank
            if tab_col.products_count > 0
              assign panel_mode = 'live'
            else
              assign panel_mode = 'empty'
            endif
          endif
        -%}

        <div
          class="nac-panel{% if is_active %} nac-panel--active{% endif %}"
          role="tabpanel"
          id="nac-panel-{{ block.id }}"
          aria-labelledby="nac-tab-{{ block.id }}"
          {% unless is_active %}hidden{% endunless %}
        >

          {%- if panel_mode == 'live' -%}
            <div class="nac-slider" role="region" aria-label="{{ block.settings.tab_label | escape }} products">
              <ul class="nac-track" role="list" data-current-index="0">
                {%- for product in tab_col.products limit: 12 -%}
                  {%- liquid
                    assign cp = product.price
                    assign cap = product.compare_at_price
                    assign has_compare = false
                    if cap > cp
                      assign has_compare = true
                    endif
                    assign discount_pct = 0
                    if has_compare and cap > 0
                      assign discount_raw = cap | minus: cp
                      assign discount_pct = discount_raw | times: 100 | divided_by: cap
                    endif
                    assign variant = product.selected_or_first_available_variant
                    assign variant_id = variant.id
                    assign is_soldout = false
                    unless product.available
                      assign is_soldout = true
                    endunless
                    assign img_loading = 'lazy'
                    assign img_fetchpri = 'auto'
                    if is_active and forloop.index <= 4
                      assign img_loading = 'eager'
                      assign img_fetchpri = 'high'
                    endif
                    assign low_stock = false
                    if nac_show_inventory and variant.inventory_management != blank
                      if variant.inventory_quantity > 0 and variant.inventory_quantity <= 10
                        assign low_stock = true
                      endif
                    endif
                  -%}

                  <li class="nac-slide" role="listitem">
                    <article class="nac-card" itemscope itemtype="https://schema.org/Product">
                      <a href="{{ product.url }}" class="nac-card__image-wrap" aria-label="{{ product.title | escape }}" itemprop="url" tabindex="0">
                        {%- if product.featured_image != blank -%}
                          <img
                            src="{{ product.featured_image | image_url: width: 512 }}"
                            srcset="{{ product.featured_image | image_url: width: 280 }} 280w, {{ product.featured_image | image_url: width: 400 }} 400w, {{ product.featured_image | image_url: width: 512 }} 512w, {{ product.featured_image | image_url: width: 768 }} 768w"
                            sizes="(max-width: 599px) calc(100vw - 64px), (max-width: 989px) calc(50vw - 48px), 280px"
                            width="280" height="350"
                            alt="{{ product.featured_image.alt | default: product.title | escape }}"
                            class="nac-card__img"
                            loading="{{ img_loading }}" fetchpriority="{{ img_fetchpri }}" decoding="async"
                            itemprop="image"
                          >
                        {%- else -%}
                          {{ 'product-1' | placeholder_svg_tag: 'nac-card__img' }}
                        {%- endif -%}

                        {%- if nac_show_badge and has_compare and discount_pct > 0 -%}
                          <span class="nac-card__badge" aria-label="{{ discount_pct | round }}% off">-{{ discount_pct | round }}%</span>
                        {%- endif -%}

                        {%- if nac_show_quick_add and variant_id != blank and is_soldout == false -%}
                          <button type="button" class="nac-card__add-btn" data-variant-id="{{ variant_id }}" aria-label="Add {{ product.title | escape }} to cart" title="Add to cart">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                            <span class="nac-spinner" aria-hidden="true"></span>
                            <svg class="nac-check" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" width="18" height="18"><polyline points="20 6 9 17 4 12"/></svg>
                          </button>
                        {%- endif -%}
                      </a>

                      <div class="nac-card__body">
                        <div class="nac-card__price-row" itemprop="offers" itemscope itemtype="https://schema.org/Offer">
                          <meta itemprop="priceCurrency" content="{{ cart.currency.iso_code }}">
                          <meta itemprop="price" content="{{ cp | divided_by: 100.0 }}">
                          <span class="nac-card__price nac-card__price--current">{{ cp | money }}</span>
                          {%- if has_compare -%}
                            <s class="nac-card__price nac-card__price--compare" aria-label="Regular price {{ cap | money }}">{{ cap | money }}</s>
                          {%- endif -%}
                        </div>
                        {%- if nac_show_vendor and product.vendor != blank -%}
                          <p class="nac-card__vendor" itemprop="brand">{{ product.vendor | escape }}</p>
                        {%- endif -%}
                        <h3 class="nac-card__title" itemprop="name">{{ product.title | escape }}</h3>
                        {%- if low_stock -%}
                          <p class="nac-card__inventory">{{ variant.inventory_quantity }} Last Items</p>
                        {%- endif -%}
                      </div>
                    </article>
                  </li>
                {%- endfor -%}
              </ul>
            </div>

          {%- elsif panel_mode == 'empty' -%}
            <div class="nac-empty-state" role="status" aria-live="polite">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
                <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"/>
              </svg>
              <p>This collection doesn&rsquo;t have any products yet.</p>
            </div>

          {%- else -%}
            {%- comment -%} DEMO MODE — show 4 demo skincare products {%- endcomment -%}
            {%- assign _demos = "bs-demo-2.svg|Endure|Plum Plum Lip Perfection Balm|1600|2600|-38%|false,bs-demo-3.svg|Endure|After Sun Lotion|2600|4500|-42%|false,bs-demo-4.svg|Hanter|Balancing Toner|2490|0||true,bs-demo-5.svg|Dazzle|Botanical Deodorant Stick|1500|2800|-46%|false" | split: "," -%}
            <div class="nac-slider" role="region" aria-label="New arrivals demo preview" aria-hidden="true">
              <ul class="nac-track" role="list" data-current-index="0">
                {%- for _entry in _demos -%}
                  {%- liquid
                    assign _p = _entry | split: "|"
                    assign _img = _p[0] | strip
                    assign _vend = _p[1] | strip
                    assign _title = _p[2] | strip
                    assign _price = _p[3] | strip | times: 1
                    assign _cap = _p[4] | strip | times: 1
                    assign _badge = _p[5] | strip
                    assign _low = false
                    if _p[6] == 'true'
                      assign _low = true
                    endif
                  -%}
                  <li class="nac-slide" role="presentation">
                    <article class="nac-card nac-card--demo">
                      <div class="nac-card__image-wrap">
                        <img src="{{ _img | asset_url }}" alt="" aria-hidden="true" width="280" height="350" class="nac-card__img" loading="lazy" decoding="async">
                        {%- if _badge != blank and _badge != '' -%}
                          <span class="nac-card__badge" aria-hidden="true">{{ _badge }}</span>
                        {%- endif -%}
                        <button type="button" class="nac-card__add-btn" aria-hidden="true" tabindex="-1" disabled>
                          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                          <span class="nac-spinner" aria-hidden="true"></span>
                          <svg class="nac-check" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                        </button>
                      </div>

                      <div class="nac-card__body">
                        <div class="nac-card__price-row">
                          <span class="nac-card__price nac-card__price--current">{{ _price | money }}</span>
                          {%- if _cap > 0 -%}
                            <s class="nac-card__price nac-card__price--compare">{{ _cap | money }}</s>
                          {%- endif -%}
                        </div>
                        <p class="nac-card__vendor">{{ _vend }}</p>
                        <h3 class="nac-card__title">{{ _title }}</h3>
                        {%- if _low -%}
                          <p class="nac-card__inventory" aria-hidden="true">5 Last Items</p>
                        {%- endif -%}
                      </div>
                    </article>
                  </li>
                {%- endfor -%}
              </ul>
            </div>
            <p class="nac-demo-hint" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false"><path fill-rule="evenodd" d="M18 10a8 8 0 1 1-16 0 8 8 0 0 1 16 0Zm-7-4a1 1 0 1 1-2 0 1 1 0 0 1 2 0ZM9 9a.75.75 0 0 0 0 1.5h.253a.25.25 0 0 1 .244.304l-.459 2.066A1.75 1.75 0 0 0 10.747 15H11a.75.75 0 0 0 0-1.5h-.253a.25.25 0 0 1-.244-.304l.459-2.066A1.75 1.75 0 0 0 9.253 9H9Z" clip-rule="evenodd"/></svg>
              Demo preview — assign a collection to this tab in the sidebar.
            </p>
          {%- endif -%}

        </div>
        {%- comment -%} END panel {%- endcomment -%}
      {%- endfor -%}

    {%- else -%}
      {%- comment -%} No blocks at all — show full demo {%- endcomment -%}
      <p class="nac-demo-hint" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false"><path fill-rule="evenodd" d="M18 10a8 8 0 1 1-16 0 8 8 0 0 1 16 0Zm-7-4a1 1 0 1 1-2 0 1 1 0 0 1 2 0ZM9 9a.75.75 0 0 0 0 1.5h.253a.25.25 0 0 1 .244.304l-.459 2.066A1.75 1.75 0 0 0 10.747 15H11a.75.75 0 0 0 0-1.5h-.253a.25.25 0 0 1-.244-.304l.459-2.066A1.75 1.75 0 0 0 9.253 9H9Z" clip-rule="evenodd"/></svg>
        Add category tab blocks in the Theme Editor to configure this section.
      </p>
    {%- endif -%}

  </div>
  {%- comment -%} END nac-container {%- endcomment -%}
</section>

<script src="{{ 'section-new-arrivals-carousel.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "New Arrivals Carousel",
  "tag": "section",
  "class": "section section-new-arrivals-carousel-wrapper",
  "settings": [
    { "type": "header", "content": "Section" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "New In" },
    { "type": "checkbox", "id": "show_navigation", "label": "Show Navigation", "default": true },
    { "type": "checkbox", "id": "enable_slider", "label": "Enable Slider", "default": true },
    { "type": "checkbox", "id": "autoplay", "label": "Autoplay", "default": false },
    { "type": "range", "id": "autoplay_speed", "label": "Autoplay Speed", "min": 2, "max": 10, "step": 1, "unit": "s", "default": 4 },
    { "type": "header", "content": "Product Cards" },
    { "type": "range", "id": "card_border_radius", "label": "Card Border Radius", "min": 0, "max": 24, "step": 2, "unit": "px", "default": 8 },
    { "type": "color", "id": "image_background", "label": "Image Background", "default": "#F3F4F6" },
    { "type": "checkbox", "id": "show_vendor", "label": "Show Vendor", "default": true },
    { "type": "checkbox", "id": "show_inventory", "label": "Show Inventory Label", "default": true, "info": "Shows '• X Last Items' when stock ≤ 10." },
    { "type": "checkbox", "id": "show_sale_badge", "label": "Show Sale Badge", "default": true, "info": "Auto-calculates discount % from compare-at price." },
    { "type": "checkbox", "id": "quick_add_button", "label": "Quick Add Button", "default": true, "info": "Shows a + button for AJAX add-to-cart." },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "color_heading", "label": "Heading", "default": "#222222" },
    { "type": "color", "id": "color_active_tab", "label": "Active Tab Text", "default": "#2563EB" },
    { "type": "color", "id": "color_active_border", "label": "Active Tab Border", "default": "#2563EB" },
    { "type": "color", "id": "color_inactive_tab", "label": "Inactive Tab Text", "default": "#1F2937" },
    { "type": "color", "id": "color_card_background", "label": "Card Background", "default": "#F3F4F6" },
    { "type": "color", "id": "color_sale_badge", "label": "Sale Badge", "default": "#E81C7F" },
    { "type": "color", "id": "color_price", "label": "Price", "default": "#E81C7F" },
    { "type": "color", "id": "color_compare_price", "label": "Compare Price", "default": "#9CA3AF" },
    { "type": "color", "id": "color_vendor", "label": "Vendor", "default": "#9CA3AF" },
    { "type": "color", "id": "color_product_title", "label": "Product Title", "default": "#1F2937" },
    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "products_per_desktop", "label": "Products Per Desktop", "options": [{ "value": "3", "label": "3 cards" }, { "value": "4", "label": "4 cards" }, { "value": "5", "label": "5 cards" }], "default": "4" },
    { "type": "select", "id": "products_per_tablet", "label": "Products Per Tablet", "options": [{ "value": "1", "label": "1 card" }, { "value": "2", "label": "2 cards" }, { "value": "3", "label": "3 cards" }], "default": "2" },
    { "type": "select", "id": "products_per_mobile", "label": "Products Per Mobile", "options": [{ "value": "1", "label": "1 card" }, { "value": "2", "label": "2 cards" }], "default": "1" },
    { "type": "range", "id": "padding_top", "label": "Section Padding Top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Section Padding Bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 }
  ],
  "blocks": [
    {
      "type": "category_tab",
      "name": "Category Tab",
      "settings": [
        { "type": "text", "id": "tab_label", "label": "Tab Label", "default": "All New" },
        { "type": "collection", "id": "collection", "label": "Collection", "info": "Products from this collection display when this tab is active." },
        { "type": "checkbox", "id": "show_tab", "label": "Show Tab", "default": true },
        { "type": "checkbox", "id": "default_active", "label": "Default Active", "default": false, "info": "Check to make this the initially selected tab. If none checked, first tab is active." }
      ]
    }
  ],
  "presets": [
    {
      "name": "New Arrivals Carousel",
      "settings": {
        "heading": "New In",
        "show_navigation": true,
        "enable_slider": true,
        "autoplay": false,
        "autoplay_speed": 4,
        "card_border_radius": 8,
        "image_background": "#F3F4F6",
        "show_vendor": true,
        "show_inventory": true,
        "show_sale_badge": true,
        "quick_add_button": true,
        "color_heading": "#222222",
        "color_active_tab": "#2563EB",
        "color_active_border": "#2563EB",
        "color_inactive_tab": "#1F2937",
        "color_card_background": "#F3F4F6",
        "color_sale_badge": "#E81C7F",
        "color_price": "#E81C7F",
        "color_compare_price": "#9CA3AF",
        "color_vendor": "#9CA3AF",
        "color_product_title": "#1F2937",
        "products_per_desktop": "4",
        "products_per_tablet": "2",
        "products_per_mobile": "1",
        "padding_top": 64,
        "padding_bottom": 64
      },
      "blocks": [
        { "type": "category_tab", "settings": { "tab_label": "All", "show_tab": true, "default_active": true } },
        { "type": "category_tab", "settings": { "tab_label": "New", "show_tab": true, "default_active": false } },
        { "type": "category_tab", "settings": { "tab_label": "Bestsellers", "show_tab": true, "default_active": false } },
        { "type": "category_tab", "settings": { "tab_label": "Accessories", "show_tab": true, "default_active": false } }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
