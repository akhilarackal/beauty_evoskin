{%- style -%}
  #FeaturedMonth-{{ section.id }} {
    --ftm-bg: {{ section.settings.background_color }};
    --ftm-pad-top: {{ section.settings.padding_top }}px;
    --ftm-pad-bottom: {{ section.settings.padding_bottom }}px;
    --ftm-container-width: {{ section.settings.container_width }}px;
    --ftm-cols: {{ section.settings.products_per_row }};
  }
{%- endstyle -%}

{{ 'section-featured-this-month.css' | asset_url | stylesheet_tag }}

<section
  id="FeaturedMonth-{{ section.id }}"
  class="ftm"
  aria-label="{{ section.settings.heading | default: 'Featured This Month' | escape }}"
  style="background-color: {{ section.settings.background_color }};"
>
  <div class="ftm__container">

    <!-- Header -->
    <header class="ftm__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="ftm__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.shop_all_label != blank -%}
        <a
          href="{{ section.settings.shop_all_link | default: '/collections/all' }}"
          class="ftm__shop-all"
        >
          {{ section.settings.shop_all_label }}
        </a>
      {%- endif -%}
    </header>

    <!-- Product Grid -->
    {%- if section.blocks.size > 0 -%}
      <div class="ftm__grid">
        {%- for block in section.blocks -%}
          {%- liquid
            assign ftm_product = block.settings.product
            assign ftm_image = block.settings.custom_image
            if ftm_image == blank and ftm_product != blank and ftm_product.featured_image != blank
              assign ftm_image = ftm_product.featured_image
            endif
            assign ftm_title = block.settings.custom_title
            if ftm_title == blank and ftm_product != blank
              assign ftm_title = ftm_product.title
            endif
            assign ftm_subtitle = block.settings.custom_subtitle
            if ftm_subtitle == blank and ftm_product != blank
              assign ftm_subtitle = ftm_product.metafields.descriptors.subtitle.value
            endif
            assign ftm_price = nil
            if ftm_product != blank
              assign ftm_price = ftm_product.price
            endif
            assign ftm_link = '#'
            if ftm_product != blank
              assign ftm_link = ftm_product.url
            endif
          -%}

          <article class="ftm__card" {{ block.shopify_attributes }}>
            <a href="{{ ftm_link }}" class="ftm__card-link" aria-label="{{ ftm_title | escape }}">

              <!-- Image Container -->
              <div class="ftm__card-image-container">
                {%- if ftm_image != blank -%}
                  <img
                    class="ftm__card-img"
                    src="{{ ftm_image | image_url: width: 600 }}"
                    srcset="
                      {{ ftm_image | image_url: width: 300 }} 300w,
                      {{ ftm_image | image_url: width: 450 }} 450w,
                      {{ ftm_image | image_url: width: 600 }} 600w,
                      {{ ftm_image | image_url: width: 800 }} 800w
                    "
                    sizes="(max-width: 749px) calc(100vw - 48px), (max-width: 989px) calc(50vw - 60px), 380px"
                    alt="{{ ftm_image.alt | default: ftm_title | escape }}"
                    width="{{ ftm_image.width | default: 600 }}"
                    height="{{ ftm_image.height | default: 600 }}"
                    loading="lazy"
                  >
                {%- else -%}
                  <div class="ftm__card-placeholder">
                    {{ 'product-1' | placeholder_svg_tag: 'ftm__placeholder-svg' }}
                  </div>
                {%- endif -%}

                {%- if block.settings.badge_text != blank -%}
                  <span class="ftm__card-badge">{{ block.settings.badge_text }}</span>
                {%- endif -%}
              </div>

              <!-- Card Info -->
              <div class="ftm__card-info">
                {%- if ftm_title != blank -%}
                  <h3 class="ftm__card-title">{{ ftm_title | escape }}</h3>
                {%- endif -%}

                {%- if ftm_subtitle != blank -%}
                  <p class="ftm__card-subtitle">{{ ftm_subtitle }}</p>
                {%- endif -%}

                {%- if ftm_price -%}
                  <p class="ftm__card-price">{{ ftm_price | money }}</p>
                {%- endif -%}
              </div>

            </a>
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Featured This Month",
  "tag": "div",
  "class": "section section-featured-this-month",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured This Month"
    },
    {
      "type": "text",
      "id": "shop_all_label",
      "label": "Shop All label",
      "default": "Shop All"
    },
    {
      "type": "url",
      "id": "shop_all_link",
      "label": "Shop All link"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FFF8F2"
    },
    {
      "type": "range",
      "id": "container_width",
      "label": "Container width",
      "min": 1000,
      "max": 1500,
      "step": 50,
      "unit": "px",
      "default": 1500
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "products_per_row",
      "label": "Products per row (desktop)",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product",
      "limit": 12,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom Image",
          "info": "Overrides product featured image."
        },
        {
          "type": "text",
          "id": "badge_text",
          "label": "Badge Text",
          "info": "Leave blank to hide badge."
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "Custom Title",
          "info": "Leave blank to use product title."
        },
        {
          "type": "text",
          "id": "custom_subtitle",
          "label": "Subtitle / Short Description",
          "info": "Leave blank to use product subtitle metafield."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured This Month",
      "blocks": [
        {
          "type": "product_card",
          "settings": {
            "badge_text": "",
            "custom_title": "Cellular Eye Lift",
            "custom_subtitle": "Firming & Depuffing Complex"
          }
        },
        {
          "type": "product_card",
          "settings": {
            "badge_text": "Exclusive",
            "custom_title": "Botanical Essence Toner",
            "custom_subtitle": "Pore-Refining Prep"
          }
        },
        {
          "type": "product_card",
          "settings": {
            "badge_text": "",
            "custom_title": "Rich Hydration Veil",
            "custom_subtitle": "Barrier Restoring Cream"
          }
        }
      ],
      "settings": {
        "heading": "Featured This Month",
        "shop_all_label": "Shop All",
        "background_color": "#FFF8F2",
        "container_width": 1500,
        "padding_top": 64,
        "padding_bottom": 64,
        "products_per_row": 3
      }
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
