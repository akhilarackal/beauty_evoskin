{{ 'section-cart-recommendations.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Shows products related to what is already in the cart, using Shopify's
  Product Recommendations API seeded with the first cart item.

  Shopify renders this same file when the JS requests
  {{ routes.product_recommendations_url }}?section_id=...&product_id=...
  at which point `recommendations` is populated.

  Falls back to a chosen collection when there is nothing to recommend.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign seed = cart.items.first.product

  assign rec_products = null
  if recommendations.performed? and recommendations.products_count > 0
    assign rec_products = recommendations.products
  elsif s.fallback_collection != blank and recommendations.performed?
    assign rec_products = s.fallback_collection.products
  endif
-%}

{%- style -%}
  #crecs-{{ section.id }} {
    --crecs-accent: {{ s.accent_color }};
    --crecs-ink: {{ s.text_color }};
    --crecs-bg: {{ s.background_color }};
    --crecs-pad-top: {{ s.padding_top }}px;
    --crecs-pad-bottom: {{ s.padding_bottom }}px;
  }
{%- endstyle -%}

<section
  id="crecs-{{ section.id }}"
  class="crecs"
  data-cart-recs
  data-url="{{ routes.product_recommendations_url }}"
  data-section-id="{{ section.id }}"
  data-limit="{{ s.products_to_show }}"
  data-intent="{{ s.intent }}"
  {% if seed %}data-product-id="{{ seed.id }}"{% endif %}
>
  <div class="crecs__inner">
    {%- if rec_products != null and rec_products.size > 0 -%}
      <header class="crecs__head">
        {%- if s.eyebrow != blank -%}
          <p class="crecs__eyebrow">{{ s.eyebrow }}</p>
        {%- endif -%}
        <h2 class="crecs__title">{{ s.heading | default: 'Complete your ritual' }}</h2>
        <span class="crecs__rule" aria-hidden="true"></span>
        {%- if s.subheading != blank -%}
          <p class="crecs__sub">{{ s.subheading }}</p>
        {%- endif -%}
      </header>

      <ul class="crecs__grid" role="list">
        {%- for product in rec_products limit: s.products_to_show -%}
          {%- liquid
            assign on_sale = false
            if product.compare_at_price > product.price
              assign on_sale = true
              assign save_pct = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price
            endif
            assign single = false
            if product.variants.size == 1 and product.selected_or_first_available_variant.available
              assign single = true
            endif
          -%}
          <li class="crecs-card">
            <div class="crecs-card__media">
              <a class="crecs-card__link" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
                {%- if product.featured_image != blank -%}
                  <img
                    src="{{ product.featured_image | image_url: width: 400 }}"
                    srcset="{{ product.featured_image | image_url: width: 250 }} 250w, {{ product.featured_image | image_url: width: 400 }} 400w"
                    sizes="(max-width: 749px) 45vw, 20vw"
                    alt="{{ product.featured_image.alt | default: product.title | escape }}"
                    width="400"
                    height="400"
                    loading="lazy"
                  >
                {%- else -%}
                  <span class="crecs-card__ph" aria-hidden="true"></span>
                {%- endif -%}
              </a>

              {%- if on_sale -%}
                <span class="crecs-card__badge">{{ save_pct }}% off</span>
              {%- endif -%}

              {%- if product.available -%}
                {%- if single -%}
                  <button
                    class="crecs-card__plus"
                    type="button"
                    data-crecs-add="{{ product.selected_or_first_available_variant.id }}"
                    aria-label="Add {{ product.title | escape }} to cart"
                  >
                    <svg class="crecs-card__plus-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                      <path d="M8 3.2v9.6M3.2 8h9.6" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/>
                    </svg>
                    <svg class="crecs-card__plus-check" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                      <path d="M3.5 8.5l3 3 6-6.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>
                {%- else -%}
                  <a class="crecs-card__plus" href="{{ product.url }}" aria-label="Choose options for {{ product.title | escape }}">
                    <svg class="crecs-card__plus-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                      <path d="M8 3.2v9.6M3.2 8h9.6" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/>
                    </svg>
                  </a>
                {%- endif -%}
              {%- endif -%}
            </div>

            <div class="crecs-card__body">
              <h3 class="crecs-card__name"><a href="{{ product.url }}">{{ product.title }}</a></h3>
              <div class="crecs-card__price">
                <span class="crecs-card__now">{{ product.price | money }}</span>
                {%- if on_sale -%}
                  <s class="crecs-card__was">{{ product.compare_at_price | money }}</s>
                {%- endif -%}
              </div>
            </div>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

<script src="{{ 'section-cart-recommendations.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Cart Recommendations",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "PAIRS BEAUTIFULLY" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Complete your ritual" },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "info": "Optional line under the heading."
    },
    {
      "type": "select",
      "id": "intent",
      "label": "Recommendation type",
      "options": [
        { "value": "related", "label": "Related products" },
        { "value": "complementary", "label": "Complementary products" }
      ],
      "default": "related",
      "info": "Complementary needs the Search & Discovery app set up."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4
    },
    {
      "type": "collection",
      "id": "fallback_collection",
      "label": "Fallback collection",
      "info": "Used when Shopify has nothing to recommend yet."
    },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#C5A044" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#1C1A17" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#FDFBF7" },
    { "type": "header", "content": "Spacing" },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ]
}
{% endschema %}
