{{ 'hero-premium.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }} {
    --hero-max-width: {{ section.settings.hero_max_width }}px;
    --hero-height: {{ section.settings.hero_height }}px;
    --hero-min-height: 400px;
    --hero-radius: {{ section.settings.border_radius }}px;
    --hero-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --hero-content-alignment: {{ section.settings.content_alignment }};
    --hero-content-max-width: {{ section.settings.content_width }}px;
    --hero-content-padding: {{ section.settings.content_padding }}px;
    --hero-btn-radius: {{ section.settings.button_radius }}px;
    --hero-promo-radius: {{ section.settings.promo_radius }}px;
    --hero-image-position-x: {{ section.settings.image_position_x | default: 50 }}%;
    --hero-image-position-y: {{ section.settings.image_position_y | default: 50 }}%;
    --hero-mobile-image-position-x: {{ section.settings.mobile_image_position_x | default: section.settings.image_position_x | default: 50 }}%;
    --hero-mobile-image-position-y: {{ section.settings.mobile_image_position_y | default: section.settings.image_position_y | default: 50 }}%;

    --hero-color-heading: {{ section.settings.color_heading }};
    --hero-color-description: {{ section.settings.color_description }};
    --hero-color-tagline: {{ section.settings.color_tagline }};
    --hero-color-promo-text: {{ section.settings.color_promo_text }};
    --hero-color-promo-bg: {{ section.settings.color_promo_bg }};
    --hero-color-promo-border: {{ section.settings.color_promo_border }};
    --hero-color-promo-code-text: {{ section.settings.color_promo_code_text }};
    --hero-color-copy-bg: {{ section.settings.color_copy_bg }};
    --hero-color-copy-text: {{ section.settings.color_copy_text }};
    --hero-color-copy-hover-bg: {{ section.settings.color_copy_hover_bg }};
    --hero-color-btn-bg: {{ section.settings.color_button_bg }};
    --hero-color-btn-text: {{ section.settings.color_button_text }};
    --hero-color-btn-hover-bg: {{ section.settings.color_button_hover_bg }};
    --hero-color-overlay: {{ section.settings.color_overlay }};
    --hero-color-nav-bg: {{ section.settings.color_nav_bg }};
    --hero-color-nav-icon: {{ section.settings.color_nav_icon }};
    --hero-color-pagination-active: {{ section.settings.color_pagination_active }};
    --hero-color-pagination-inactive: {{ section.settings.color_pagination_inactive }};
  }

  #shopify-section-{{ section.id }} {
    --padding-top: {{ section.settings.padding_top }}px;
    --padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media screen and (max-width: 749px) {
    .section-{{ section.id }} {
      --hero-height: {{ section.settings.hero_height_mobile | default: section.settings.hero_height | times: 0.6 | round }}px;
    }
  }
{%- endstyle -%}

<div
  class="hero-premium section-{{ section.id }}"
  data-autoplay="{{ section.settings.autoplay }}"
  data-speed="{{ section.settings.speed }}"
  data-pause-on-focus="{{ section.settings.pause_on_focus }}"
  data-show-nav="{{ section.settings.show_navigation }}"
  data-show-pagination="{{ section.settings.show_pagination }}"
  role="region"
  aria-label="{{ section.settings.section_label | default: 'Hero slider' | escape }}"
>
  <div class="hero-premium__container">
    {%- if section.blocks.size > 0 -%}
      <div
        class="hero-premium__track"
        aria-live="polite"
        aria-atomic="false"
      >
        {%- for block in section.blocks -%}
          {%- liquid
            assign is_active = false
            if forloop.first
              assign is_active = true
            endif

            assign fetch_priority = 'auto'
            assign loading = 'lazy'
            if forloop.first
              assign fetch_priority = 'high'
              assign loading = 'eager'
            endif
          -%}
          <div
            class="hero-premium__slide{% if is_active %} is-active{% endif %}"
            data-slide-index="{{ forloop.index0 }}"
            role="tabpanel"
            id="hero-slide-{{ section.id }}-{{ forloop.index0 }}"
            aria-hidden="{% if is_active %}false{% else %}true{% endif %}"
            aria-label="Slide {{ forloop.index }} of {{ section.blocks.size }}"
            {% if is_active %}aria-current="true"{% endif %}
            tabindex="{% if is_active %}0{% else %}-1{% endif %}"
            {{ block.shopify_attributes }}
          >
            {%- comment -%} Background Images {%- endcomment -%}
            {%- if block.settings.desktop_image != blank -%}
              <div class="hero-premium__image hero-premium__image--desktop">
                {{ block.settings.desktop_image | image_url: width: 1920 | image_tag:
                  widths: '800, 1000, 1200, 1400, 1600, 1920',
                  fetchpriority: fetch_priority,
                  loading: loading,
                  alt: block.settings.heading | escape
                }}
              </div>
            {%- else -%}
              <div class="hero-premium__image hero-premium__image--desktop hero-premium__image--placeholder">
                {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
            {%- endif -%}

            {%- if block.settings.mobile_image != blank -%}
              <div class="hero-premium__image hero-premium__image--mobile">
                {{ block.settings.mobile_image | image_url: width: 750 | image_tag:
                  widths: '375, 550, 750',
                  loading: loading,
                  alt: block.settings.heading | escape
                }}
              </div>
            {%- endif -%}

            {%- comment -%} Overlay {%- endcomment -%}
            <div class="hero-premium__overlay" aria-hidden="true"></div>

            {%- comment -%} Content {%- endcomment -%}
            <div class="hero-premium__content">
              {%- if block.settings.tagline != blank -%}
                <p class="hero-premium__tagline">&ldquo;{{ block.settings.tagline }}&rdquo;</p>
              {%- endif -%}

              {%- if block.settings.heading != blank -%}
                <h2 class="hero-premium__heading">{{ block.settings.heading }}</h2>
              {%- endif -%}

              {%- if block.settings.description != blank -%}
                <div class="hero-premium__description">{{ block.settings.description }}</div>
              {%- endif -%}

              {%- if block.settings.promo_text != blank -%}
                <p class="hero-premium__promo-text">{{ block.settings.promo_text }}</p>
              {%- endif -%}

              {%- if block.settings.promo_code != blank -%}
                <div class="hero-premium__promo-code">
                  <span class="hero-premium__code-display">{{ block.settings.promo_code }}</span>
                  <button
                    type="button"
                    class="hero-premium__copy-btn"
                    data-code="{{ block.settings.promo_code | escape }}"
                    aria-label="{{ block.settings.copy_button_label | default: 'Copy promo code' | escape }}: {{ block.settings.promo_code | escape }}"
                  >
                    <span class="hero-premium__copy-icon" aria-hidden="true">
                      {{- 'icon-copy.svg' | inline_asset_content -}}
                    </span>
                    <span class="hero-premium__copy-text">{{ block.settings.copy_button_label | default: 'Copy Code' }}</span>
                    <span class="hero-premium__copied-text" aria-hidden="true">Copied!</span>
                  </button>
                </div>
              {%- endif -%}

              {%- if block.settings.primary_button_label != blank -%}
                <a
                  href="{{ block.settings.primary_button_link | default: '#' }}"
                  class="hero-premium__button"
                  {% if block.settings.primary_button_link == blank %}aria-disabled="true"{% endif %}
                >
                  {{ block.settings.primary_button_label }}
                </a>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>

      {%- comment -%} Navigation {%- endcomment -%}
      {%- if section.blocks.size > 1 -%}
        {%- if section.settings.show_navigation or section.settings.show_pagination -%}
          <div class="hero-premium__nav">
            {%- if section.settings.show_navigation -%}
              <button
                type="button"
                class="hero-premium__prev"
                aria-label="Previous slide"
                data-action="prev"
              >
                {{- 'icon-arrow-left.svg' | inline_asset_content -}}
              </button>
            {%- endif -%}

            {%- if section.settings.show_pagination -%}
              <div class="hero-premium__pagination" role="tablist" aria-label="Slide navigation">
                {%- for block in section.blocks -%}
                  <button
                    type="button"
                    class="hero-premium__indicator{% if forloop.first %} is-active{% endif %}"
                    role="tab"
                    id="hero-tab-{{ section.id }}-{{ forloop.index0 }}"
                    aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                    aria-controls="hero-slide-{{ section.id }}-{{ forloop.index0 }}"
                    aria-label="Go to slide {{ forloop.index }}"
                    data-slide-index="{{ forloop.index0 }}"
                    tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
                  ></button>
                {%- endfor -%}
              </div>
            {%- endif -%}

            {%- if section.settings.show_navigation -%}
              <button
                type="button"
                class="hero-premium__next"
                aria-label="Next slide"
                data-action="next"
              >
                {{- 'icon-arrow-right.svg' | inline_asset_content -}}
              </button>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endif -%}
    {%- else -%}
      <div class="hero-premium__empty">
        {{ 'onboarding.no_content' | t }}
      </div>
    {%- endif -%}
  </div>
</div>

<script src="{{ 'hero-premium.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Hero Slider Premium",
  "tag": "section",
  "class": "section-hero-premium",
  "limit": 1,
  "settings": [
    {
      "type": "text",
      "id": "section_label",
      "label": "Accessibility label",
      "default": "Hero slider"
