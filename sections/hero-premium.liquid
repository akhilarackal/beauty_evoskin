      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Image position"
    },
    {
      "type": "range",
      "id": "image_position_x",
      "label": "Desktop image horizontal position",
      "info": "0% aligns left, 50% centers, 100% aligns right.",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "image_position_y",
      "label": "Desktop image vertical position",
      "info": "0% aligns top, 50% centers, 100% aligns bottom.",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "mobile_image_position_x",
      "label": "Mobile image horizontal position",
