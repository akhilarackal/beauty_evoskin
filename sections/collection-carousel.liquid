{{ 'section-collection-carousel.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign bg = section.settings.background_color
  if bg != blank
    assign bg_style = '--sbc-bg:' | append: bg | append: ';'
  else
    assign bg_style = ''
  endif
-%}

<div
  class="collection-carousel"
  id="CollectionCarousel-{{ section.id }}"
  data-autoplay="{{ section.settings.autoplay }}"
  data-speed="{{ section.settings.autoplay_speed | default: 5 }}"
  style="{{ bg_style }} --sbc-pad-top: {{ section.settings.padding_top }}px; --sbc-pad-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="collection-carousel__container">
    {%- if section.settings.heading != blank -%}
      <h2 class="collection-carousel__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="collection-carousel__viewport">
        <ul
          class="collection-carousel__track"
          role="list"
          tabindex="0"
          aria-label="{{ section.settings.heading | default: 'Shop by Collections' | escape }}"
        >
          {%- for block in section.blocks -%}
            {%- liquid
              assign collection = block.settings.collection
              assign image = block.settings.image
              if image == blank and collection.featured_image
                assign image = collection.featured_image
              endif
              assign title = block.settings.title
              if title == blank
                if collection.title != blank
                  assign title = collection.title
                else
                  assign title = 'Collection'
                endif
              endif
              assign url = '#'
              if collection != blank and collection.url
                assign url = collection.url
              endif
            -%}
            <li
              class="collection-carousel__slide"
              {{ block.shopify_attributes }}
              data-index="{{ forloop.index0 }}"
            >
              <a
                href="{{ url }}"
                class="collection-carousel__card"
                aria-label="{{ title | escape }}"
              >
                <div class="collection-carousel__image-wrap">
                  {%- if image != blank -%}
                    {{
                      image
                      | image_url: width: 600
                      | image_tag:
                        loading: 'lazy',
                        widths: '180, 240, 360, 480, 600',
                        sizes: '183px',
                        alt: title,
                        class: 'collection-carousel__img'
                    }}
                  {%- else -%}
                    {{ 'collection-' | append: forloop.index | placeholder_svg_tag: 'collection-carousel__img' }}
                  {%- endif -%}
                </div>
                <span class="collection-carousel__title">{{ title | escape }}</span>
              </a>
            </li>
          {%- endfor -%}
        </ul>

        {%- if section.settings.show_arrows and section.blocks.size > 5 -%}
          <div class="collection-carousel__buttons">
            <button
              type="button"
              class="collection-carousel__button"
              data-action="prev"
              aria-label="{{ 'sections.collection_carousel.previous' | t }}"
            >
              {%- render 'icon-arrow-left' -%}
            </button>
            <button
              type="button"
              class="collection-carousel__button"
              data-action="next"
              aria-label="{{ 'sections.collection_carousel.next' | t }}"
            >
              {%- render 'icon-arrow-right' -%}
            </button>
          </div>
        {%- endif -%}
      </div>
    {%- else -%}
      <div class="collection-carousel__empty">
        {{ 'sections.collection_carousel.empty' | t }}
      </div>
    {%- endif -%}
  </div>
</div>

<script src="{{ 'section-collection-carousel.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Collection Carousel",
  "tag": "section",
  "class": "section section-collection-carousel",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Collections"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Carousel"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show navigation arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable autoplay",
      "info": "Off by default.",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay speed (seconds)",
      "min": 3,
      "max": 12,
      "step": 1,
      "unit": "s",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Image (optional override)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom Title (optional override)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection Carousel",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}
