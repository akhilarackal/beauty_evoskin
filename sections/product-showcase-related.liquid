{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #psrp-{{ section.id }} {
    --psrp-bg: {{ section.settings.background_color }};
    --psrp-heading-color: {{ section.settings.heading_color }};
    --psrp-pad-top: {{ section.settings.padding_top }}px;
    --psrp-pad-bottom: {{ section.settings.padding_bottom }}px;
  }

  .psrp-section {
    width: 100%;
    background: var(--psrp-bg, #ffffff);
  }

  .psrp-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: var(--psrp-pad-top, 60px) 32px var(--psrp-pad-bottom, 60px);
  }

  .psrp-header {
    text-align: center;
    margin-bottom: 40px;
  }

  .psrp-header__title {
    font-family: 'Playfair Display', serif;
    font-weight: 600;
    font-size: 28px;
    line-height: 1.3;
    color: var(--psrp-heading-color, #111827);
    margin: 0;
  }

  .psrp-grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns }}, 1fr);
    gap: 24px;
  }

  .psrp-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    text-decoration: none;
    transition: transform 0.3s ease;
  }

  .psrp-card:hover {
    transform: translateY(-4px);
  }

  .psrp-card__image {
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: 8px;
    overflow: hidden;
    background: #f5f5f5;
  }

  .psrp-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .psrp-card__info {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 0 4px;
  }

  .psrp-card__title {
    font-family: 'Poppins', sans-serif;
    font-weight: 500;
    font-size: 14px;
    line-height: 1.4;
    color: #111827;
    margin: 0;
  }

  .psrp-card__price {
    font-family: 'Poppins', sans-serif;
    font-size: 14px;
    color: #6B7280;
  }

  .psrp-card__price--sale {
    color: #C5A044;
    font-weight: 600;
  }

  .psrp-card__price--compare {
    text-decoration: line-through;
    color: #9CA3AF;
    margin-left: 8px;
  }

  @media screen and (max-width: 989px) {
    .psrp-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media screen and (max-width: 575px) {
    .psrp-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }

    .psrp-container {
      padding-left: 16px;
      padding-right: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .psrp-card {
      transition: none;
    }
    .psrp-card:hover {
      transform: none;
    }
  }
{%- endstyle -%}

<section id="psrp-{{ section.id }}" class="psrp-section" aria-label="{{ section.settings.heading | default: 'Related Products' | escape }}">
  <product-recommendations
    class="psrp-recommendations"
    data-url="{{ routes.product_recommendations_url }}?limit={{ section.settings.products_to_show }}"
    data-section-id="{{ section.id }}"
    data-product-id="{{ product.id }}"
  >
  <div class="psrp-container">

    {%- if section.settings.heading != blank -%}
      <header class="psrp-header">
        <h2 class="psrp-header__title">{{ section.settings.heading }}</h2>
      </header>
    {%- endif -%}

    <div class="psrp-grid">
      {%- if recommendations.performed and recommendations.products_count > 0 -%}
        {%- for product in recommendations.products limit: section.settings.products_to_show -%}
          <a href="{{ product.url }}" class="psrp-card">
            <div class="psrp-card__image">
              {%- if product.featured_image != blank -%}
                <img
                  src="{{ product.featured_image | image_url: width: 400 }}"
                  srcset="{{ product.featured_image | image_url: width: 300 }} 300w, {{ product.featured_image | image_url: width: 400 }} 400w"
                  sizes="(max-width: 575px) 45vw, (max-width: 989px) 30vw, 20vw"
                  alt="{{ product.featured_image.alt | default: product.title | escape }}"
                  width="400"
                  height="400"
                  loading="lazy"
                >
              {%- else -%}
                {{ 'product-' | append: forloop.index | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
            <div class="psrp-card__info">
              <h3 class="psrp-card__title">{{ product.title }}</h3>
              <div class="psrp-card__price">
                {%- if product.compare_at_price > product.price -%}
                  <span class="psrp-card__price--sale">{{ product.price | money }}</span>
                  <span class="psrp-card__price--compare">{{ product.compare_at_price | money }}</span>
                {%- else -%}
                  <span>{{ product.price | money }}</span>
                {%- endif -%}
              </div>
            </div>
          </a>
        {%- endfor -%}
      {%- elsif recommendations.performed == false -%}
        {%- comment -%} Fallback: static collection if recommendations not yet loaded {%- endcomment -%}
        {%- assign fallback_collection = section.settings.collection -%}
        {%- if fallback_collection != blank and fallback_collection.products.size > 0 -%}
          {%- for product in fallback_collection.products limit: section.settings.products_to_show -%}
            <a href="{{ product.url }}" class="psrp-card">
              <div class="psrp-card__image">
                {%- if product.featured_image != blank -%}
                  <img
                    src="{{ product.featured_image | image_url: width: 400 }}"
                    srcset="{{ product.featured_image | image_url: width: 300 }} 300w, {{ product.featured_image | image_url: width: 400 }} 400w"
                    sizes="(max-width: 575px) 45vw, (max-width: 989px) 30vw, 20vw"
                    alt="{{ product.featured_image.alt | default: product.title | escape }}"
                    width="400"
                    height="400"
                    loading="lazy"
                  >
                {%- else -%}
                  {{ 'product-' | append: forloop.index | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </div>
              <div class="psrp-card__info">
                <h3 class="psrp-card__title">{{ product.title }}</h3>
                <div class="psrp-card__price">
                  {%- if product.compare_at_price > product.price -%}
                    <span class="psrp-card__price--sale">{{ product.price | money }}</span>
                    <span class="psrp-card__price--compare">{{ product.compare_at_price | money }}</span>
                  {%- else -%}
                    <span>{{ product.price | money }}</span>
                  {%- endif -%}
                </div>
              </div>
            </a>
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..6) -%}
            <div class="psrp-card">
              <div class="psrp-card__image">
                {{ 'product-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
              <div class="psrp-card__info">
                <h3 class="psrp-card__title">Product {{ i }}</h3>
                <div class="psrp-card__price"><span>$49.99</span></div>
              </div>
            </div>
          {%- endfor -%}
        {%- endif -%}
      {%- endif -%}
    </div>

  </div>
  </product-recommendations>
</section>

{% schema %}
{
  "name": "Showcase Related Products",
  "tag": "section",
  "class": "product-showcase-related",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Related Products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns (desktop)",
      "min": 3,
      "max": 6,
      "step": 1,
      "default": 5
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#111827"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Showcase Related Products"
    }
  ]
}
{% endschema %}
